# Copier ce fichier en keystore.properties et remplir les valeurs (ne jamais commiter keystore.properties)
# Les variables d'environnement KEYSTORE_PATH, KEYSTORE_PASSWORD, KEY_ALIAS, KEY_PASSWORD
# sont prioritaires sur ce fichier (utilisé en CI).
storeFile=path/to/release.jks
storePassword=
keyAlias=
keyPassword=
