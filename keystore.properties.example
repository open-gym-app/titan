# Copy this file to keystore.properties and fill in the values (never commit keystore.properties)
# Environment variables KEYSTORE_PATH, KEYSTORE_PASSWORD, KEY_ALIAS, KEY_PASSWORD
# take precedence over this file (used in CI).
# Path to the keystore, relative to the app/ directory (or absolute). java.util.Properties has
# no inline comments: anything after the path on the same line becomes part of it.
storeFile=../release.jks
storePassword=
keyAlias=
keyPassword=
