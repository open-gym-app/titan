<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Auto-backup stays on, and takes none of the user's data with it.

      `allowBackup="true"` with no rules is the platform default, and for an app whose entire
      value is one local SQLite file it is wrong in a way that loses data quietly: Android
      uploads the database and every DataStore file to the user's Drive, then restores that
      snapshot on reinstall *before first launch*, with no prompt and no way to decline — a
      months-old training history written over whatever the user has, and a `.db` restored
      beside a `-wal` sidecar it may not match, which is how a database comes back corrupt
      rather than merely stale.

      Off wholesale is the obvious fix and the worse one; the argument for excluding the files
      instead is in `res/xml/data_extraction_rules.xml`, along with the list itself. Both
      files say the same thing — `dataExtractionRules` for Android 12 and above,
      `fullBackupContent` for Android 11 and below — because the platform reads one and
      ignores the other, so an exclusion in only one is a hole that opens on old phones.

      This is also what makes the app's own copy true. "No account. No cloud. Everything stays
      on this phone" was a claim the manifest was contradicting. Data leaves the device only
      through an export the user asked for (#37, #38).
    -->
    <application
        android:name=".TitanApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Titan">

        <!--
          Portrait only, on purpose rather than by omission.

          Landscape is not broken today, but supporting it is a commitment every screen from
          #23 onwards would have to honour — a set row, a rest timer and a summary each laid
          out twice, screenshot-tested twice — for a use we do not have: the app is used
          standing over a bench, one-handed, on a phone.

          LockedOrientationActivity is lint telling us this hurts large screens. It is
          correct, and it is already moot: at our targetSdk of 36, Android 16 ignores
          orientation restrictions on displays 600dp and wider outright, so this locks phones
          and nothing else — exactly the scope we mean. Revisit with the tablet layouts, not
          before.
        -->
        <!--
          `singleTop` because of the deep links below. Without it, a notification tapped while
          the app is already running builds a *second* MainActivity over the first — two copies
          of the shell, two navigation graphs, and a back gesture that walks out of one into the
          other. With it the intent is delivered to the running instance through `onNewIntent`,
          which `TitanNavHost` hands to the NavController.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            tools:ignore="LockedOrientationActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              The app's own address space — `DeepLinks` in `:core:domain` is where the URIs are
              built, and this is the filter that resolves them. Matched on the scheme and host
              rather than on each path, so a new screen under an existing host is one
              `navDeepLink` in the feature that owns it and no manifest change here. A new
              *host* is one line, which is what the second `data` element is: the session flow
              and the progression screens are the two the app links into so far.

              A private scheme rather than an https App Link: these links are posted by this app
              to itself, on notifications, and an App Link would mean owning a domain and
              serving an assetlinks file to make a rest timer open.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="titan" android:host="session" />
                <data android:scheme="titan" android:host="progression" />
            </intent-filter>
        </activity>

        <!--
          WorkManager, initialised on demand rather than at launch.

          `androidx.startup` runs `WorkManagerInitializer` from the library's own manifest,
          which initialises WorkManager with the *default* worker factory — before
          `TitanApplication`'s `Configuration.Provider` is ever consulted. The auto-backup
          worker (#181) is built by Hilt, so that factory could not construct it, and the
          failure would land in a background job at three in the morning.

          Removing the meta-data leaves the `InitializationProvider` in place for any other
          `androidx.startup` component and defers WorkManager to the first
          `WorkManager.getInstance` call — the backup toggle being flipped, or the OS running
          the job. `tools:node="merge"` so this edits the merged provider rather than
          declaring a second one.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

    </application>

</manifest>
