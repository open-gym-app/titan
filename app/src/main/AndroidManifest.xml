<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:name=".OpenGymApplication"
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.OpenGym">

        <!--
          Portrait only, on purpose rather than by omission.

          Landscape is not broken today, but supporting it is a commitment every screen from
          #23 onwards would have to honour — a set row, a rest timer and a summary each laid
          out twice, screenshot-tested twice — for a use we do not have: the app is used
          standing over a bench, one-handed, on a phone.

          LockedOrientationActivity is lint telling us this hurts large screens. It is
          correct, and it is already moot: at our targetSdk of 36, Android 16 ignores
          orientation restrictions on displays 600dp and wider outright, so this locks phones
          and nothing else — exactly the scope we mean. Revisit with the tablet layouts, not
          before.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            tools:ignore="LockedOrientationActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          How a backup file reaches the share sheet.

          A `file://` URI passed to another app has thrown `FileUriExposedException` since
          Android 7, so the export is handed over as a `content://` URI this provider grants
          read access to for one intent. `${applicationId}` rather than a literal: the debug
          and staging builds add an `applicationIdSuffix`, and a hard-coded authority would be
          wrong on two of the three variants — and would collide if two of them were installed
          side by side, which is exactly how this repo is developed.

          `android:exported="false"` with `grantUriPermissions`: nothing may query this
          provider, and the only access anybody gets is the one-shot grant attached to the
          share intent. See `res/xml/file_paths.xml` for what it is scoped to.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
