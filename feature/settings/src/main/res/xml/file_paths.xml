<?xml version="1.0" encoding="utf-8"?>
<!--
  What the app's FileProvider is allowed to hand to another app.

  Backups only, and only the `backups/` directory under app-specific storage — not the whole
  files directory, which also holds `in-progress-session.json`. A provider scoped wider would
  let any app that guessed a path read a draft workout out of an authority granted for a
  share sheet.

  Both variants of app-specific storage are declared because backups live under either root
  (`BackupDirectory`, implemented by `AppBackupDirectory` in `:core:data`): internal storage
  below Android 11, where the external files directory is readable by other apps with storage
  access (#259), and the external files directory from Android 11, or internal storage there
  too on a device with no external volume mounted. On Android 8 to 10 no file manager can reach
  a backup, so the share sheet and "Save a copy…" are the only ways one leaves the app, and the
  internal path is what lets the share work there.
-->
<paths>
    <external-files-path
        name="backups"
        path="backups/" />
    <files-path
        name="internal-backups"
        path="backups/" />
</paths>
