    <!-- Automatic backup (#181). The toggle under the export section. -->
    <string name="backup_auto_title">Automatic backup</string>
    <string name="backup_auto_detail">Writes a copy of everything once a week, while the phone is charging and no one is using it. The three most recent are kept; older ones are deleted.</string>
    <string name="backup_auto_action">Weekly auto-backup</string>
    <string name="backup_auto_off">Off. Nothing is written on a schedule.</string>
    <string name="backup_auto_never">On. The first one runs the next time the phone is charging overnight.</string>
    <string name="backup_auto_last">Last backup %1$s</string>
    <string name="backup_auto_failed">The last automatic backup did not finish, after several attempts. It will try again on the next run.</string>
    <string name="backup_auto_save_failed">That switch could not be saved. Try again.</string>
    <!-- The one sentence in this section a user must not miss; see AutoBackupSection. -->
    <string name="backup_auto_uninstall">Automatic backups stay in Titan\'s own storage, even after you turn this off, until you uninstall the app or delete all data. Export and save a copy for one that outlives it.</string>

    <string name="backup_restore_title">Restore</string>
    <string name="backup_restore_detail">Replaces everything on this device with the contents of a backup file. It does not merge the two.</string>
    <string name="backup_restore_action">Choose a backup file</string>
    <string name="backup_validating">Checking the file…</string>
    <string name="backup_importing">Restoring…</string>
    <string name="backup_restore_done">Restored %1$d rows. Everything on this device now comes from the file.</string>

    <!--
      One message per ImportError. Each says what went wrong and, for the five that guarantee
      it, that nothing on the device was touched; the other three say what was — see
      BackupLabels.kt.
    -->
    <string name="backup_error_malformed">That file is not a Titan backup, or it is damaged. Nothing on this device was changed.</string>
    <string name="backup_error_version">That backup was written at format version %1$d and this build reads version %2$d. Update Titan and try again. Nothing on this device was changed.</string>
    <string name="backup_error_constraint">That backup contradicts itself — it refers to workouts it does not contain, or holds values no version of Titan writes. Nothing on this device was changed.</string>
    <string name="backup_error_constraint_live_state">That backup contradicts itself — it refers to workouts it does not contain, or holds values no version of Titan writes. Your history and settings were not changed, but the workout or template you had open may have been closed.</string>
    <string name="backup_error_io">The backup could not be read. Nothing on this device was changed.</string>
    <string name="backup_error_io_live_state">The backup could not be written to this device. Your history and settings were not changed, but the workout or template you had open may have been closed.</string>
    <string name="backup_error_live_state">That backup was not restored: the workout or template you had open could not be closed first. Your history and settings were not changed, but that workout or template may have been closed.</string>
    <string name="backup_error_too_large">That file is larger than any Titan backup (over %1$s), so it was not read. Nothing on this device was changed.</string>
    <string name="backup_error_settings">Restored %1$d rows, but your settings could not be saved and may be back at their defaults. Check them in Settings.</string>
    <string name="backup_error_reminders">Restored %1$d rows and your settings, but your workout reminder could not be updated to match. Check it in Settings.</string>

    <string name="backup_dismiss">Dismiss</string>

    <string name="backup_restore_dialog_title">Replace everything?</string>
    <string name="backup_restore_dialog_body">Restoring does not merge. Everything below is deleted and replaced by whatever the file holds.</string>
    <string name="backup_restore_dialog_body_empty">There is nothing logged on this device yet, so there is nothing to lose — the file\'s contents simply replace it.</string>
    <string name="backup_restore_dialog_file">File: %1$s</string>
