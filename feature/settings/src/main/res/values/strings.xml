    <!--
      One message per ImportError. Each says what went wrong and, for the three that guarantee
      it, that nothing on the device was touched — see BackupLabels.kt.
    -->
    <string name="backup_error_malformed">That file is not an Open Gym backup, or it is damaged. Nothing on this device was changed.</string>
    <string name="backup_error_version">That backup was written at format version %1$d and this build reads version %2$d. Update Open Gym and try again. Nothing on this device was changed.</string>
    <string name="backup_error_constraint">That backup is incomplete — it refers to workouts it does not contain. Nothing on this device was changed.</string>
    <string name="backup_error_io">The backup could not be read. If the restore had already started, your workouts are back but your settings may not be.</string>

    <string name="backup_dismiss">Dismiss</string>

