    <string name="quest_log_period_remaining">%1$d XP still to earn</string>
    <string name="quest_log_period_all_clear">Every quest cleared. Strong period.</string>
    <!-- One sentence per cadence card: name, cleared, total, XP left. -->
    <plurals name="quest_log_period_description">
        <item quantity="one">%1$s, %2$d of %3$d cleared, %4$d XP still to earn</item>
        <item quantity="other">%1$s, %2$d of %3$d cleared, %4$d XP still to earn</item>
    </plurals>
    <!-- The same card once nothing is left, which the plural above would read out as "0 XP still
         to earn" — the same fact phrased as a disappointment. Matches what the card draws. -->
    <string name="quest_log_period_description_cleared">%1$s, %2$d of %3$d cleared. Every quest cleared.</string>
    <!-- The label over the quests already banked this period. -->
    <string name="quest_log_quests_cleared">Cleared · %1$d</string>

    <!-- The quests themselves. Weekly first, then monthly, matching `Quests.ALL`. -->
    <string name="quest_weekly_sessions">Train three times</string>
    <string name="quest_weekly_sessions_plus">Train five times</string>
    <string name="quest_weekly_record">Break a personal record</string>
    <string name="quest_weekly_volume">Move 20 tonnes</string>
    <string name="quest_monthly_sessions">Train twelve times</string>
    <string name="quest_monthly_records">Break five personal records</string>
    <string name="quest_monthly_volume">Move 80 tonnes</string>
    <!-- A quest id with no string behind it, which only a build mid-rename can produce. -->
    <string name="quest_unknown">Quest</string>

    <!-- The row on the quest board that leads to the achievements. -->
    <string name="quest_log_achievements_heading">Achievements</string>
    <!-- %1$d held, %2$d in the catalogue. -->
    <string name="quest_log_achievements_count">%1$d / %2$d</string>
    <string name="quest_log_achievements_link_caption">Everything you have unlocked</string>
    <!-- The row's two drawn lines, then the count: a link's spoken name carries the words
         written on it, so a user who reads the caption can say it to Voice Access. -->
    <string name="quest_log_achievements_link_description">Achievements, everything you have unlocked: %1$d of %2$d</string>

    <!-- The achievements screen (#104). Their own surface: an achievement is a permanent
         one-shot unlock, a quest resets — see `AchievementsUiState`. -->
    <string name="achievements_title">Achievements</string>
    <string name="achievements_heading">Milestones</string>
    <string name="achievements_caption">Permanent unlocks. Unlike quests, they never reset.</string>
    <!-- %1$d held, %2$d in the catalogue. -->
    <string name="achievements_count">%1$d / %2$d</string>
    <string name="achievements_locked">Locked</string>
    <!-- A locked medal says only that it is locked — #104 is explicit that it reveals nothing
         about how to unlock it beyond what the catalogue already defines. -->
    <string name="achievements_locked_description">%1$s, locked</string>
    <!-- %1$s the milestone, %2$s its metal. The metal is spoken because the medal draws the
         rank in colour, and a rank carried by colour alone is a rank half the readers lose. -->
    <string name="achievements_unlocked_description">%1$s, unlocked, %2$s medal</string>
    <!-- The same, once a date is known: %3$s is when it was earned. The metal and the date
         run together as the hero card draws them - "Bronze · Earned Feb 16" - so the card's
         spoken name holds the line written on it. -->
    <string name="achievements_unlocked_dated_description">%1$s, unlocked, %2$s, earned %3$s</string>
    <!-- What tapping a held medal does. Spoken as the action, never drawn: the medal replays its
         strike, which is a flourish and not a state change worth labelling on screen. -->
    <string name="achievements_replay_action">Strike it again</string>

    <!-- The hero: the medal most recently earned, struck again as the screen opens. -->
    <string name="achievements_latest_eyebrow">Latest medal</string>
    <!-- %1$s the metal, %2$s the date it was struck. -->
    <string name="achievements_latest_meta">%1$s · Earned %2$s</string>
    <!-- The hero before there is one. Not an error and not an empty state: the shelf below is
         full of what there is to earn, and this names the one action that strikes the first. -->
    <string name="achievements_none_title">No medals yet</string>
    <string name="achievements_none_body">Finish a workout and the first one is struck.</string>

    <!-- The metals, which rank a milestone against the others measured the same way. -->
    <string name="achievements_tier_gold">Gold</string>
    <string name="achievements_tier_silver">Silver</string>
    <string name="achievements_tier_bronze">Bronze</string>

    <!-- The achievement names, resolved from the domain catalogue's ids. Duplicated from
         `:feature:session`, which draws the same milestones on the session summary: a string
         resource is per module, and a shared one would mean a `:core:ui` that knows the
         gamification catalogue. -->
    <string name="achievement_first_session">First workout logged</string>
    <string name="achievement_ten_sessions">Ten workouts in</string>
    <string name="achievement_hundred_sessions">One hundred workouts</string>
    <string name="achievement_four_week_streak">A month-long streak</string>
    <string name="achievement_twelve_week_streak">A three-month streak</string>
    <string name="achievement_first_record">First personal record</string>
    <string name="achievement_unknown">Achievement</string>

