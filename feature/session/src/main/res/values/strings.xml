<?xml version="1.0" encoding="utf-8"?>
<!--
  The session flow's strings.

  The active session is still scaffolding (#26) and its placeholder text is written inline
  where it can be read next to the layout it labels. Everything the user is actually meant to
  read and act on is here, and translatable.

  Labels are written in sentence case even where the design draws them uppercase: `Eyebrow`
  and `OpenGymBadge` uppercase for the caller, so a translator is never asked to reproduce a
  typographic treatment.
-->
<resources>

    <!-- ── New session (#25) ──────────────────────────────────────────────────────── -->

    <string name="new_session_title">New session</string>
    <!-- The back arrow means two different things, so it says which. -->
    <string name="new_session_leave">Leave without starting</string>
    <string name="new_session_back_to_list">Back to the template list</string>

    <string name="new_session_quick_start">Quick start</string>
    <string name="new_session_empty">Empty session</string>
    <string name="new_session_empty_hint">Start blank, pick as you go</string>

    <string name="new_session_templates">Templates</string>
    <plurals name="new_session_template_count">
        <item quantity="one">%1$d saved</item>
        <item quantity="other">%1$d saved</item>
    </plurals>

    <!-- Before the user has saved a template. It names where templates come from, because
         nothing on this screen creates one — an empty list with no explanation reads as a
         broken feature rather than an unused one. -->
    <string name="new_session_no_templates_title">No templates yet</string>
    <string name="new_session_no_templates_body">Finish a workout and save it as a template, and it shows up here ready to run again.</string>

    <!-- ── Ready to start ─────────────────────────────────────────────────────────── -->

    <string name="new_session_ready">Ready</string>
    <!-- Stands in for a session built by hand, which has no name until the workout gives it
         one. Deliberately the same words as the action that produced it. -->
    <string name="new_session_unnamed">Empty session</string>
    <plurals name="new_session_exercise_count">
        <item quantity="one">%1$d exercise</item>
        <item quantity="other">%1$d exercises</item>
    </plurals>
    <!-- "8 exercises · ~55m". Only a session started from a template has the second half. -->
    <string name="new_session_ready_meta">%1$s · %2$s</string>
    <!-- The superset marker on a review row: "SS A1". -->
    <string name="new_session_superset">SS %1$s</string>
    <string name="new_session_remove">Remove %1$s</string>
    <string name="new_session_start">Start workout</string>
    <!-- The review panel's title doubles as the way to name the session before it starts. -->
    <string name="new_session_rename">Name this session</string>

    <!-- The refused start, which is the one refusal here that asks something rather than
         reporting it: the workout in the way is offered back. See ResumeSessionDialog. -->
    <string name="new_session_resume_eyebrow">Still running</string>
    <!-- What is in the workout being offered back, which is the figure the choice turns on. -->
    <plurals name="new_session_resume_sets">
        <item quantity="one">%1$d set logged</item>
        <item quantity="other">%1$d sets logged</item>
    </plurals>
    <string name="new_session_resume_nothing_logged">Nothing logged yet</string>
    <string name="new_session_resume_body">Only one workout runs at a time.</string>
    <string name="new_session_resume_confirm">Pick it back up</string>
    <!-- Says both halves of what it does: the workout in the way is deleted, and the planned
         one is started in its place. -->
    <string name="new_session_resume_discard">Discard it and start</string>
    <string name="new_session_resume_dismiss">Not now</string>

    <string name="new_session_error_start_failed">Could not start the session. Nothing was saved.</string>
    <string name="new_session_error_discard">Could not discard the running workout. It is still there.</string>
    <string name="new_session_error_template">That template could not be opened.</string>
    <!-- Shown when exercises in the plan have been deleted from the library since it was saved. -->
    <string name="new_session_error_exercises_missing">Some exercises are no longer in your library and were left out.</string>

    <!-- ── Active session (#26) ───────────────────────────────────────────────────── -->

    <!-- The exercise open on screen. The count is not in it: the header's progress rail
         already says how far through the workout this is, and "EX 4 / 8" beside a rail that
         is half filled is the same fact twice. -->
    <string name="active_exercise_position">Exercise %1$d</string>
    <!-- An exercise deleted from the library since the session started. The sets logged
         against it still happened, so it keeps its place rather than vanishing mid-workout. -->
    <string name="active_exercise_removed">Removed from your library</string>
    <!-- An exercise with nothing behind it: the PREV column has nothing to put in any of its
         cells, and a column of dashes reads as a fault rather than as a first attempt. Said
         once beside the name rather than repeated down the column. -->
    <string name="active_first_time">First time</string>

    <string name="active_complete_set">Complete set %1$d</string>
    <string name="active_add_note">Add a note</string>
    <string name="active_note_label">Note</string>
    <string name="active_note_clear">Clear</string>

    <!-- The two refusals this screen words itself. Everything else a set can be refused for
         is `SetValidator`'s own wording, shown as it stands — it names the field, the bound
         and the value it saw, which is more than a paraphrase could. -->
    <string name="active_weight_not_a_number">That weight is not a number</string>
    <string name="active_reps_not_a_number">That rep count is not a number</string>

    <!-- An exercise whose sets are measured in time — a plank, a row on the erg. The row above
         this takes a weight and a rep count, so there is nowhere to put the one thing a set of
         it has to record, and `SetValidator` would refuse every set logged from here. Said on
         the card rather than left as a tick that does nothing: the dead end is the exercise's,
         and the way out of it is to take the exercise out of the workout. -->
    <string name="active_logged_by_duration">Timed exercise. Sets are recorded by duration, which this screen cannot enter yet — swap it out or remove it to keep going.</string>

    <!-- The action that opens the picker from inside a running workout. "More" rather than
         "exercises", because the button sits under the ones the session already has. -->
    <string name="active_add_exercises">Add more exercises</string>
    <string name="active_remove_exercise">Remove %1$s from this workout</string>
    <!-- The other way to change what is in a slot: the machine is taken, so something else goes
         in its place — at the same point in the workout, in the same superset. -->
    <string name="active_swap_exercise">Swap %1$s for another exercise</string>

    <!-- A session started empty, before any exercise has been added to it. -->
    <string name="active_no_exercises_title">No exercises yet</string>
    <string name="active_no_exercises_body">This session was started empty. Add the first exercise below and start logging.</string>

    <!-- The rating sheet. -->
    <string name="active_rpe_title">How hard was that?</string>
    <string name="active_rpe_body">Rate of perceived exertion, for the set you are logging. Tap the value again to clear it.</string>

    <!-- A session id that no longer resolves to a row. -->
    <string name="active_missing_title">This session is gone</string>
    <string name="active_missing_body">It was deleted or finished somewhere else. Nothing here can be logged against it.</string>

    <string name="active_error_no_sets">Log at least one set before finishing, or discard the workout.</string>
    <string name="active_error_finish">Could not finish the session. Nothing was saved and the workout is still running.</string>
    <string name="active_error_discard">Could not discard the session. It is still running.</string>
    <string name="active_error_set">That set could not be logged.</string>
    <string name="active_error_pause">Could not change the session. Try again.</string>
    <string name="active_error_add">Could not add those exercises. The workout is unchanged.</string>
    <!-- The one refusal here that is a rule rather than a failure, so it names the way past
         itself instead of suggesting a retry. -->
    <string name="active_error_exercise_has_sets">That exercise has sets logged against it. Delete the sets first, or discard the whole workout.</string>
    <string name="active_error_remove">Could not remove that exercise. It is still in the workout.</string>
    <string name="active_error_rename">Could not rename the session. Try again.</string>
    <!-- Both directions of the superset control, which is one thing to the user. -->
    <string name="active_error_superset">Could not change that superset. The workout is unchanged.</string>
    <string name="active_error_reorder">Could not save the new order. The workout is in the order it was.</string>
    <!-- The second refusal here that is a rule rather than a failure. It names a different way
         past itself than the removal does: a swap can also be had by adding the new exercise and
         leaving the sets where they are. -->
    <string name="active_error_swap_has_sets">That exercise has sets logged against it. Delete them first, or add the new exercise instead.</string>
    <string name="active_error_swap">Could not swap that exercise. The workout is unchanged.</string>
    <!-- Shown on open, when the screen could not be put back where the workout was left. -->
    <string name="active_error_restore">Could not pick the workout back up where you left it. Your logged sets are safe.</string>

    <!-- ── Correcting a logged set ────────────────────────────────────────────────── -->

    <!-- The undo offer. Names the set by the number it was drawn under, which is what the user
         was just looking at. -->
    <string name="active_set_deleted">Set %1$d deleted</string>
    <string name="active_undo">Undo</string>
    <string name="active_error_set_edit">That change could not be saved. The set is as it was.</string>
    <string name="active_error_delete_set">Could not delete that set. It is still in the workout.</string>
    <!-- The one failure here that costs the user something they did, so it says so. -->
    <string name="active_error_restore_set">Could not put that set back. Log it again to record it.</string>
    <string name="active_error_restored_at_end">Set put back, at the end of the exercise.</string>
    <!-- The tick, either way round: one sentence for both, because "nothing happened" is the
         whole of what there is to say and the row still shows what the set says. -->
    <string name="active_error_set_completion">Could not change that set\'s tick.</string>

    <!-- ── Session summary (#27) ──────────────────────────────────────────────────── -->

    <!-- The eyebrow over the header. Which one is shown is the whole of what the two render
         modes differ in at the top of the screen: one announces a result, the other labels a
         record. -->
    <string name="summary_complete">Session complete</string>
    <string name="summary_logged">Logged session</string>
    <string name="summary_back">Back to the session list</string>
    <!-- A session started empty and never named. The date under it is what identifies it, so
         this stands in for a name rather than inventing one. -->
    <string name="summary_unnamed">Unnamed session</string>
    <!-- The recap's title doubles as the way to change it, in both modes: a workout is often
         named after it is over, and one logged months ago is as renameable as today's. -->
    <string name="summary_rename">Rename this session</string>
    <!-- "10:14 → 11:06 · 52:14", under the day. Every part is a numeric, so the line is set in
         the mono role and the separators are typographic rather than words. -->
    <string name="summary_meta">%1$s · %2$s</string>
    <string name="summary_time_range">%1$s → %2$s</string>

    <!-- The session id no longer resolves to a row — deleted from another screen, in
         practice. -->
    <string name="summary_missing_title">Session not found</string>
    <string name="summary_missing_body">This session is no longer in your history. It may have been deleted.</string>

    <!-- Records. The heading is plural because the section is absent entirely when there are
         none, so it is never drawn over a single-item list by accident. -->
    <string name="summary_records">New personal records</string>
    <string name="summary_records_historical">Personal records</string>
    <!-- The exercise a record no longer resolves to. The record still stands — it is a thing
         the user did — so it is titled rather than dropped. -->
    <string name="summary_record_unknown">Exercise no longer in your library</string>

    <string name="summary_muscles">Muscles worked</string>
    <!-- The tail of a muscle breakdown too long to draw in full. -->
    <string name="summary_muscles_more">+%1$d more</string>

    <string name="summary_exercises">Exercises</string>
    <string name="summary_exercise_unknown">Removed from your library</string>
    <!-- The figure line under an exercise: "4 × 8-10 · 80 kg max". The set count and the rep
         range are one part because they are read as one phrase. -->
    <string name="summary_exercise_sets">%1$d × %2$s</string>
    <string name="summary_exercise_rep_range">%1$d-%2$d</string>
    <string name="summary_exercise_top_weight">%1$s max</string>
    <string name="summary_exercise_meta">%1$s · %2$s</string>
    <!-- Announced for a breakdown row, which is otherwise read out as an index, a name and a
         line of abbreviations. These spell out what the row abbreviates: "4 × 8-10" is read
         as four sets of eight to ten reps. -->
    <string name="summary_exercise_description_position">%1$d. %2$s</string>
    <plurals name="summary_exercise_description_sets">
        <item quantity="one">%1$d set</item>
        <item quantity="other">%1$d sets</item>
    </plurals>
    <plurals name="summary_exercise_description_reps">
        <item quantity="one">%1$d rep</item>
        <item quantity="other">%1$d reps</item>
    </plurals>
    <string name="summary_exercise_description_rep_range">%1$d to %2$d reps</string>

    <string name="summary_notes">Session notes</string>
    <string name="summary_notes_label">Session notes</string>
    <string name="summary_notes_empty">Add a note about this session — how it felt, what to change next time.</string>

    <!-- Actions. "Done" ends the flow; it is absent in the historical view, where the back
         arrow is the way out. -->
    <string name="summary_save_template">Save as template</string>
    <string name="summary_done">Done</string>

    <!-- The dialog behind "Save as template". Its field, its category chips and its cancel are
         `TemplateNameDialog`'s own — this screen supplies only what is specific to saving a
         workout you have just finished. -->
    <string name="summary_template_title">Save as template</string>
    <string name="summary_template_body">The exercises you performed, in order, with the sets, reps and weights you hit as their defaults.</string>
    <string name="summary_template_save">Save</string>
    <!-- Drawn under the name field, not in the snackbar: the dialog is still up with the name
         the user typed in it, and that is the thing they have to change. -->
    <string name="summary_template_name_taken">You already have a template with that name</string>

    <string name="summary_error_notes">Could not save the note</string>
    <string name="summary_error_rename">Could not rename the session</string>
    <string name="summary_template_saved">Saved as a template</string>
    <string name="summary_error_template">Could not save the template</string>

    <!-- ─── The post-workout payoff (#111) ─────────────────────────────────────────────
         Drawn only in the just-finished mode. A historical recap of the same session says
         none of it: nothing was achieved by opening a workout from last March. -->

    <string name="summary_xp_earned">XP earned</string>
    <!-- Set beside the figure rather than inside it, so the two carry different type roles. -->
    <string name="summary_xp_unit">XP</string>
    <!-- Spoken in place of the counting digits. %1$d is the total earned. -->
    <string name="summary_xp_earned_description">%1$d experience points earned</string>
    <!-- One line of the breakdown. %1$d is what that source paid. -->
    <string name="summary_xp_source_amount">+%1$d</string>
    <string name="summary_xp_source_session">Finishing the session</string>

    <plurals name="summary_xp_source_sets">
        <item quantity="one">%1$d set</item>
        <item quantity="other">%1$d sets</item>
    </plurals>

    <plurals name="summary_xp_source_records">
        <item quantity="one">%1$d personal record</item>
        <item quantity="other">%1$d personal records</item>
    </plurals>

    <plurals name="summary_xp_source_achievements">
        <item quantity="one">%1$d achievement</item>
        <item quantity="other">%1$d achievements</item>
    </plurals>

    <string name="summary_level_up">Level up</string>
    <!-- A level ending in 0 or 5. Named rather than merely drawn louder: a crossing that is only
         bigger reads as the same event with the volume up. See `LevelCeremony`. -->
    <string name="summary_level_milestone">Milestone reached</string>
    <!-- %1$d is the level now held. -->
    <string name="summary_level_number">Level %1$d</string>
    <!-- Points into the current level, over what a level costs: "43 / 100". -->
    <string name="summary_level_progress">%1$d / %2$d</string>

    <!-- The progress bar's own sentence: the bar is a separate node and a reader arriving at
         it alone would otherwise hear a bare proportion. %1$d is the level, %2$d the points
         still to go. -->
    <plurals name="summary_level_progress_description">
        <item quantity="one">Level %1$d, %2$d point to the next level</item>
        <item quantity="other">Level %1$d, %2$d points to the next level</item>
    </plurals>

    <string name="summary_achievements">Achievements unlocked</string>
    <string name="summary_achievement_badge">New</string>

    <!-- The milestone names. The catalogue is `Achievements` in the domain, which is a plain
         Kotlin object with no resources of its own; the words live here so the app stays
         translatable. An id with no string here draws the fallback below. -->
    <string name="achievement_first_session">First workout logged</string>
    <string name="achievement_ten_sessions">Ten workouts in</string>
    <string name="achievement_hundred_sessions">One hundred workouts</string>
    <string name="achievement_seven_day_streak">A week-long streak</string>
    <string name="achievement_thirty_day_streak">A month-long streak</string>
    <string name="achievement_first_record">First personal record</string>
    <!-- A milestone unlocked by a newer build than this one. Drawn rather than dropped: it is
         still a thing the user did. -->
    <string name="achievement_unknown">Achievement unlocked</string>

</resources>
