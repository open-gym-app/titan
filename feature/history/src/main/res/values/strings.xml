<?xml version="1.0" encoding="utf-8"?>
<!--
  Strings for the Sessions tab and the exercise library.

  Written in sentence case even where the design draws them uppercase: `Eyebrow`,
  `OpenGymBadge` and `OpenGymFilterChip` all uppercase for the caller, so a translator is
  never asked to reproduce a typographic treatment.
-->
<resources>

    <!-- ── Exercise library ───────────────────────────────────────────────────────── -->

    <!-- The picker's title. The tab's is the bottom bar's own label, drawn by the shell.
         Two of them, because the picker asks two different questions: it adds to a workout, or
         it fills one slot on an exercise already in one. -->
    <string name="library_title_select">Add exercises</string>
    <string name="library_title_replace">Swap exercise</string>
    <string name="library_back">Back</string>
    <string name="library_new">+ New</string>
    <!-- The same action as a bare `+`, where the bar has a title to fit too. -->
    <string name="library_new_description">New exercise</string>
    <string name="library_search_placeholder">Search exercises…</string>

    <!-- The two icon buttons in the bar. Read aloud by TalkBack; the glyphs carry no text. -->
    <string name="library_search">Search</string>
    <string name="library_filters">Filters</string>

    <!-- The picker's per-row secondary action: open the exercise rather than tick it. The row
         itself is the checkbox there, so this is the only way through to the detail. -->
    <string name="library_details">Details of %1$s</string>

    <!-- The filter sheet: one heading per vocabulary, and its way out. The button says what
         is left rather than "apply", because the filters are already applied. -->
    <string name="library_filter_muscle">Muscle</string>
    <string name="library_filter_equipment">Equipment</string>
    <string name="library_filters_clear">Clear</string>
    <plurals name="library_filters_done">
        <item quantity="one">Show %1$d exercise</item>
        <item quantity="other">Show %1$d exercises</item>
    </plurals>

    <!-- The count, in whichever bar is drawn. Three phrasings, because the number means three
         different things: how much there is, how much is left after filtering, how much has
         been picked. -->
    <plurals name="library_count">
        <item quantity="one">%1$d exercise</item>
        <item quantity="other">%1$d exercises</item>
    </plurals>
    <string name="library_count_filtered">%1$d of %2$d</string>
    <plurals name="library_selected">
        <item quantity="one">%1$d selected</item>
        <item quantity="other">%1$d selected</item>
    </plurals>

    <!-- The muscle filter's "no filter" chip. -->
    <string name="library_filter_all">All</string>

    <!-- Section headings: the muscle group, then how many are under it — "CHEST · 12". One
         string rather than two drawn side by side, so it is one node to a screen reader. -->
    <string name="library_section_header">%1$s · %2$d</string>
    <!-- The section for exercises the catalogue links to no muscle group at all. -->
    <string name="library_section_unlinked">Other</string>

    <!-- Empty states. The glyphs are drawn text, not icons — the design's marks are
         typographic throughout. -->
    <string name="library_glyph_search">⌕</string>
    <string name="library_glyph_empty">☐</string>
    <string name="library_no_results_title">Nothing matches</string>
    <string name="library_no_results_description">No exercise matches your search and filters.</string>
    <string name="library_clear_filters">Clear filters</string>
    <string name="library_empty_title">The library is empty</string>
    <string name="library_empty_description">The bundled exercise catalogue did not load. Reinstalling the app restores it.</string>

    <!-- The picker's confirm bar. No plural on the swap pair: a slot takes one exercise, so
         the count is one or none and the button says which of the two it is. -->
    <string name="library_confirm_none">Select exercises</string>
    <plurals name="library_confirm">
        <item quantity="one">Add %1$d exercise</item>
        <item quantity="other">Add %1$d exercises</item>
    </plurals>
    <string name="library_confirm_replace_none">Select a replacement</string>
    <string name="library_confirm_replace">Swap it in</string>

    <string name="library_exercise_created">Exercise created</string>
    <string name="library_save_failed">Could not save the exercise</string>

    <!-- ── Exercise form ──────────────────────────────────────────────────────────── -->
    <!-- One form for authoring a custom exercise and for correcting one. Only the heading
         and the submit button differ between the two. -->

    <string name="exercise_form_title_new">New exercise</string>
    <string name="exercise_form_title_edit">Edit exercise</string>
    <string name="exercise_form_name">Name</string>
    <string name="exercise_form_name_duplicate">You already have this exercise with this equipment</string>
    <!-- "Measured as" rather than "Type": the choice decides what the set row asks for. -->
    <string name="exercise_form_type">Measured as</string>
    <string name="exercise_form_equipment">Equipment</string>
    <string name="exercise_form_primary_muscle">Primary muscle</string>
    <string name="exercise_form_secondary_muscles">Also works</string>
    <string name="exercise_form_notes">Notes (optional)</string>
    <string name="exercise_form_cancel">Cancel</string>
    <string name="exercise_form_create">Create</string>
    <string name="exercise_form_save">Save</string>
    <!-- Shown in the sheet itself, not as a snackbar: the sheet covers the snackbar's host. -->
    <string name="exercise_form_save_failed">Could not save the exercise. Try again.</string>

    <!-- ── Exercise detail ────────────────────────────────────────────────────────── -->

    <string name="detail_back">Back</string>
    <string name="detail_edit">Edit exercise</string>
    <string name="detail_delete">Delete exercise</string>

    <string name="detail_section_muscles">Muscles worked</string>
    <!-- "How to" rather than "Instructions": it is the bundled dataset's own wording for a
         list of steps, and the shorter heading leaves room for the rule beside it. -->
    <string name="detail_section_instructions">How to</string>
    <!-- Deliberately distinct from the section above. `Exercise.instructions` is the same for
         everybody; `Exercise.notes` is the user's own. -->
    <string name="detail_section_notes">Your notes</string>

    <string name="detail_muscles_primary">Primary</string>
    <string name="detail_muscles_secondary">Secondary</string>
    <!-- Announced as one phrase: "Primary, Chest" rather than a badge and a list read apart. -->
    <string name="detail_muscles_description">%1$s, %2$s</string>
    <!-- Quoted: Android trims unquoted whitespace, which would join the names up. -->
    <string name="detail_muscle_separator">", "</string>

    <!-- The metadata cells. "Type" for the discipline, because that is the word a lifter uses
         for what kind of exercise something is; "Tracked" says what a set of it records. -->
    <string name="detail_meta_discipline">Type</string>
    <string name="detail_meta_equipment">Equipment</string>
    <string name="detail_meta_mechanic">Mechanic</string>
    <string name="detail_meta_difficulty">Difficulty</string>
    <string name="detail_meta_tracked">Tracked</string>

    <!-- The two jumps off the screen. Neither destination exists yet (#95, M5), so neither
         button is drawn — the strings land with the screen that draws them. -->
    <string name="detail_plate_calculator">Plate calculator</string>
    <string name="detail_progression">Progression</string>

    <string name="detail_add_to_session">Add to session</string>

    <!-- The two halves of `NotesCard` a caller supplies. The pencil's description and the
         two buttons are the component's own, in :core:ui, because they say the same thing
         wherever a note is written; the prompt below is here because advice about a seat
         setting says nothing under a workout. -->
    <string name="detail_notes_label">Your notes</string>
    <string name="detail_notes_empty">Add a note about this exercise — a seat setting, a cue, which machine at your gym.</string>
    <string name="detail_notes_save_failed">Could not save the note</string>

    <string name="detail_exercise_updated">Exercise updated</string>
    <string name="detail_exercise_save_failed">Could not save the exercise</string>

    <string name="detail_delete_title">Delete this exercise?</string>
    <string name="detail_delete_body">%1$s will be removed from your library. It can only be deleted while no logged session or template still uses it.</string>
    <string name="detail_delete_confirm">Delete</string>
    <string name="detail_delete_cancel">Cancel</string>
    <string name="detail_delete_failed">Could not delete the exercise</string>

    <!-- The glyph is drawn text, not an icon — the design's marks are typographic. -->
    <string name="detail_glyph_missing">☐</string>
    <string name="detail_missing_title">Exercise not found</string>
    <string name="detail_missing_description">This exercise is no longer in your library.</string>

    <!-- ── Plate calculator ───────────────────────────────────────────────────────── -->

    <string name="plate_title">Plate calculator</string>
    <string name="plate_back">Back</string>

    <!-- The big figure. Announced with the weight in it, because the number itself is drawn
         as digits and a suffix and would otherwise be read as two unrelated nodes. -->
    <string name="plate_target">Target weight</string>
    <string name="plate_target_edit">Target weight, %1$s. Tap to type one</string>
    <string name="plate_target_field_label">Weight (%1$s)</string>
    <string name="plate_target_invalid">Enter a weight above zero</string>

    <!-- The heading over the barbell. The bar is named here because everything below it is
         "per side", and a lifter reading the plates needs to know what they are added to. -->
    <string name="plate_per_side_bar">Per side · bar %1$s</string>

    <!-- The line that keeps the big number honest — see PlateCalculatorScreen. -->
    <string name="plate_shortfall">Loads to %1$s · %2$s short of your target</string>
    <string name="plate_below_bar">Lighter than the empty %1$s bar</string>

    <!-- The equipment editor. -->
    <string name="plate_equipment">Bar &amp; plates</string>
    <string name="plate_equipment_bar">Bar</string>
    <string name="plate_equipment_plates">Plates · pairs on the rack</string>
    <string name="plate_equipment_reset">Use the standard set</string>
    <string name="plate_bar_lighter">Lighter bar</string>
    <string name="plate_bar_heavier">Heavier bar</string>
    <string name="plate_pairs_fewer">One fewer pair of %1$s</string>
    <string name="plate_pairs_more">One more pair of %1$s</string>

    <string name="plate_dialog_save">Set</string>
    <string name="plate_dialog_cancel">Cancel</string>
    <string name="plate_save_failed">Could not save your equipment</string>

    <!-- ── Sessions tab ───────────────────────────────────────────────────────────── -->

    <!-- The three tabs. Sentence case; OpenGymTabRow uppercases them. -->
    <string name="sessions_tab_history">History</string>
    <string name="sessions_tab_templates">Templates</string>
    <string name="sessions_tab_calendar">Calendar</string>

    <!-- The header's count, in the three phrasings the number needs: how much there is, how
         much survived the filters, and — on the calendar — which month is on screen. -->
    <plurals name="sessions_count">
        <item quantity="one">%1$d session</item>
        <item quantity="other">%1$d sessions</item>
    </plurals>
    <string name="sessions_count_filtered">%1$d of %2$d</string>
    <plurals name="sessions_templates_count">
        <item quantity="one">%1$d template</item>
        <item quantity="other">%1$d templates</item>
    </plurals>
    <!-- "APRIL 2026 · 13 SESSIONS", as one node so a screen reader does not read the month
         and the count three swipes apart. -->
    <string name="sessions_calendar_heading">%1$s · %2$s</string>

    <!-- The header's actions. Read aloud by TalkBack; the glyphs carry no text. -->
    <string name="sessions_new">+ New</string>
    <string name="sessions_new_description">New session</string>
    <string name="sessions_new_template_description">New template</string>
    <string name="sessions_search">Search</string>
    <string name="sessions_search_placeholder">Search names and notes…</string>

    <!-- Month headings in the history list: "APRIL 2026 · 4". -->
    <string name="sessions_month_heading">%1$s · %2$d</string>

    <!-- The history's two empty states, which are not the same state: a user who has logged
         nothing is offered the way to start, and one whose filters matched nothing is offered
         the way back. -->
    <string name="sessions_glyph_empty">◇</string>
    <string name="sessions_glyph_search">⌕</string>
    <string name="sessions_empty_title">No sessions yet</string>
    <string name="sessions_empty_description">Every workout you log lands here, with what you lifted and how long it took.</string>
    <string name="sessions_empty_action">Start a session</string>
    <string name="sessions_no_results_title">Nothing in that window</string>
    <string name="sessions_no_results_description">No session matches your search and the dates you picked.</string>
    <string name="sessions_clear_filters">Clear filters</string>

    <!-- The templates tab. The empty state's action opens the editor on a blank template,
         because this is the only list in the app the user could otherwise not add to. The
         description still names the other way one is made — finishing a workout and saving it,
         which brings the sets and weights actually hit along as its defaults. -->
    <string name="sessions_templates_glyph">▤</string>
    <string name="sessions_templates_empty_title">No templates yet</string>
    <string name="sessions_templates_empty_description">Build one here, or finish a workout and save it as a template to start the same session again in one tap.</string>
    <string name="sessions_templates_empty_action">Create a template</string>

    <!-- A template row's overflow menu, and the two dialogs behind it. -->
    <string name="sessions_template_actions">More for %1$s</string>
    <string name="sessions_template_rename">Rename</string>
    <string name="sessions_template_duplicate">Duplicate</string>
    <string name="sessions_template_delete">Delete</string>
    <!-- What a copy is offered as. Only a proposal: the dialog is what makes it the user's. -->
    <string name="sessions_template_copy_name">%1$s (copy)</string>
    <string name="sessions_template_rename_title">Rename template</string>
    <string name="sessions_template_rename_confirm">Rename</string>
    <string name="sessions_template_duplicate_title">Duplicate template</string>
    <string name="sessions_template_duplicate_body">The same exercises, in the same order, with the same sets. Give the copy a name of its own.</string>
    <string name="sessions_template_duplicate_confirm">Duplicate</string>
    <!-- Drawn under the name field, not in the snackbar: the dialog is still up with the name
         the user typed in it, and that is the thing they have to change. -->
    <string name="sessions_template_name_taken">You already have a template with that name</string>

    <!-- Deleting one. The question names it, because "delete this template?" is a different
         question when the answer is a plan built up over a month — and it says what is *not*
         lost, since the workouts already done from it are the thing a user would fear for. -->
    <string name="sessions_template_delete_title">Delete “%1$s”?</string>
    <string name="sessions_template_delete_body">The sessions you have already logged from it stay exactly where they are.</string>
    <string name="sessions_template_delete_confirm">Delete</string>
    <string name="sessions_template_delete_cancel">Cancel</string>

    <!-- One-shot outcomes. There is none for a rename: the row redrawing under its new name
         is the confirmation. -->
    <string name="sessions_template_duplicated">Template duplicated</string>
    <string name="sessions_template_deleted">Template deleted</string>
    <string name="sessions_template_gone">That template is no longer there</string>
    <string name="sessions_template_failed">Could not change the template</string>

    <!-- The date sheet. -->
    <string name="sessions_dates">Dates</string>
    <string name="sessions_dates_all">All time</string>
    <plurals name="sessions_dates_last_days">
        <item quantity="one">Last %1$d day</item>
        <item quantity="other">Last %1$d days</item>
    </plurals>
    <string name="sessions_dates_custom">Pick dates…</string>
    <string name="sessions_dates_range">%1$s – %2$s</string>
    <string name="sessions_dates_done">Done</string>
    <string name="sessions_dates_confirm">Apply</string>
    <string name="sessions_dates_cancel">Cancel</string>

    <!-- The calendar tab. -->
    <string name="sessions_calendar_previous">Previous month</string>
    <string name="sessions_calendar_next">Next month</string>
    <string name="sessions_calendar_legend">Shade shows the day\'s volume against the month\'s heaviest</string>
    <string name="sessions_calendar_empty">Nothing logged this month</string>
    <string name="sessions_calendar_stat_sessions">Sessions</string>
    <string name="sessions_calendar_stat_time">Time</string>
    <!-- No "volume" label: that chip labels itself with the unit suffix, kg or lb. -->

    <!-- ── Template editor ────────────────────────────────────────────────────────── -->

    <string name="template_editor_title">Edit template</string>
    <string name="template_editor_new_title">New template</string>
    <string name="template_editor_untitled">Untitled template</string>
    <string name="template_editor_back">Back</string>
    <string name="template_editor_save">Save</string>
    <string name="template_editor_exercises">Exercises</string>
    <string name="template_editor_add_exercises">Add exercises</string>

    <!-- The header row doubles as the way to rename, so the dialog it opens says both things
         it edits rather than only the name. -->
    <string name="template_editor_name_title">Name and category</string>
    <string name="template_editor_name_confirm">Apply</string>
    <string name="template_editor_name_taken">You already have a template with that name</string>

    <!-- An exercise deleted from the library since the template was saved. It keeps its place:
         the plan is the user's, and a line silently dropped is a workout that got shorter. -->
    <string name="template_exercise_position">Exercise %1$d</string>
    <string name="template_exercise_removed">Removed from your library</string>
    <string name="template_remove_exercise">Remove %1$s from this template</string>
    <string name="template_swap_exercise">Swap %1$s for another exercise</string>

    <!-- The plan's own table: a row per set, and the one rest that follows all of them. The
         set rows' own labels come from :core:ui, which draws the same cells in the workout. -->
    <string name="template_add_set">Add set</string>
    <string name="template_remove_set">Remove set %1$d of %2$s</string>
    <!-- Captions are drawn under the cells, so they are as short as the boxes they name; the
         descriptions are what a screen reader hears. -->
    <!-- Said of the field itself, which is where a screen reader will hear it. The bounds are
         not spelled out: what is wrong is nearly always a stray character. -->
    <string name="template_field_invalid">Not a number this can plan</string>

    <!-- A template edited down to nothing. Not an error — the user is mid-edit — but the save
         is inert until something is back in it, and this says why. -->
    <string name="template_editor_empty_title">Nothing in this template</string>
    <string name="template_editor_empty_body">Add at least one exercise before saving.</string>

    <!-- Opened on a template that is not there, or deleted from the list while this was open. -->
    <string name="template_editor_missing_title">No such template</string>
    <string name="template_editor_missing_body">It has been deleted. The sessions you logged from it are still in your history.</string>
    <string name="template_editor_missing_action">Back to templates</string>

    <!-- Leaving with unsaved edits. -->
    <string name="template_editor_discard_title">Leave without saving?</string>
    <string name="template_editor_discard_body">The template stays exactly as it was. The changes you just made are lost.</string>
    <string name="template_editor_discard_new_body">Nothing has been saved yet, so the template you were building is lost.</string>
    <string name="template_editor_discard_confirm">Discard</string>
    <string name="template_editor_discard_cancel">Keep editing</string>

    <!-- One-shot outcomes. There is none for a save that worked: the screen closes on it. -->
    <string name="template_editor_exercises_unavailable">Some of those exercises are no longer in your library and were left out</string>
    <string name="template_editor_exercise_unavailable">That exercise is no longer in your library, so nothing was changed</string>
    <!-- The app was killed while the user was in the picker, so the editor it would have added
         to is gone. Says what did not happen and what to do about it, rather than adding the
         exercises to a plan that has lost everything else. -->
    <string name="template_editor_restarted">The editor reopened, so those exercises were not added. Pick them again.</string>
    <string name="template_editor_save_failed">Could not save the template</string>

</resources>
