<?xml version="1.0" encoding="utf-8"?>
<!--
  Strings for the Sessions tab and the exercise library.

  Written in sentence case even where the design draws them uppercase: `Eyebrow`,
  `OpenGymBadge` and `OpenGymFilterChip` all uppercase for the caller, so a translator is
  never asked to reproduce a typographic treatment.
-->
<resources>

    <!-- ── Exercise library ───────────────────────────────────────────────────────── -->

    <!-- The picker's title. The tab's is the bottom bar's own label, drawn by the shell. -->
    <string name="library_title_select">Add exercises</string>
    <string name="library_back">Back</string>
    <string name="library_new">+ New</string>
    <!-- The same action as a bare `+`, where the bar has a title to fit too. -->
    <string name="library_new_description">New exercise</string>
    <string name="library_search_placeholder">Search exercises…</string>

    <!-- The two icon buttons in the bar. Read aloud by TalkBack; the glyphs carry no text. -->
    <string name="library_search">Search</string>
    <string name="library_filters">Filters</string>

    <!-- The picker's per-row secondary action: open the exercise rather than tick it. The row
         itself is the checkbox there, so this is the only way through to the detail. -->
    <string name="library_details">Details of %1$s</string>

    <!-- The filter sheet: one heading per vocabulary, and its way out. The button says what
         is left rather than "apply", because the filters are already applied. -->
    <string name="library_filter_muscle">Muscle</string>
    <string name="library_filter_equipment">Equipment</string>
    <string name="library_filters_clear">Clear</string>
    <plurals name="library_filters_done">
        <item quantity="one">Show %1$d exercise</item>
        <item quantity="other">Show %1$d exercises</item>
    </plurals>

    <!-- The count, in whichever bar is drawn. Three phrasings, because the number means three
         different things: how much there is, how much is left after filtering, how much has
         been picked. -->
    <plurals name="library_count">
        <item quantity="one">%1$d exercise</item>
        <item quantity="other">%1$d exercises</item>
    </plurals>
    <string name="library_count_filtered">%1$d of %2$d</string>
    <plurals name="library_selected">
        <item quantity="one">%1$d selected</item>
        <item quantity="other">%1$d selected</item>
    </plurals>

    <!-- The muscle filter's "no filter" chip. -->
    <string name="library_filter_all">All</string>

    <!-- Section headings: the muscle group, then how many are under it — "CHEST · 12". One
         string rather than two drawn side by side, so it is one node to a screen reader. -->
    <string name="library_section_header">%1$s · %2$d</string>
    <!-- The section for exercises the catalogue links to no muscle group at all. -->
    <string name="library_section_unlinked">Other</string>

    <!-- Empty states. The glyphs are drawn text, not icons — the design's marks are
         typographic throughout. -->
    <string name="library_glyph_search">⌕</string>
    <string name="library_glyph_empty">☐</string>
    <string name="library_no_results_title">Nothing matches</string>
    <string name="library_no_results_description">No exercise matches your search and filters.</string>
    <string name="library_clear_filters">Clear filters</string>
    <string name="library_empty_title">The library is empty</string>
    <string name="library_empty_description">The bundled exercise catalogue did not load. Reinstalling the app restores it.</string>

    <!-- The picker's confirm bar. -->
    <string name="library_confirm_none">Select exercises</string>
    <plurals name="library_confirm">
        <item quantity="one">Add %1$d exercise</item>
        <item quantity="other">Add %1$d exercises</item>
    </plurals>

    <string name="library_exercise_created">Exercise created</string>
    <string name="library_save_failed">Could not save the exercise</string>

    <!-- ── Exercise form ──────────────────────────────────────────────────────────── -->
    <!-- One form for authoring a custom exercise and for correcting one. Only the heading
         and the submit button differ between the two. -->

    <string name="exercise_form_title_new">New exercise</string>
    <string name="exercise_form_title_edit">Edit exercise</string>
    <string name="exercise_form_name">Name</string>
    <string name="exercise_form_name_duplicate">You already have this exercise with this equipment</string>
    <!-- "Measured as" rather than "Type": the choice decides what the set row asks for. -->
    <string name="exercise_form_type">Measured as</string>
    <string name="exercise_form_equipment">Equipment</string>
    <string name="exercise_form_primary_muscle">Primary muscle</string>
    <string name="exercise_form_secondary_muscles">Also works</string>
    <string name="exercise_form_notes">Notes (optional)</string>
    <string name="exercise_form_cancel">Cancel</string>
    <string name="exercise_form_create">Create</string>
    <string name="exercise_form_save">Save</string>
    <!-- Shown in the sheet itself, not as a snackbar: the sheet covers the snackbar's host. -->
    <string name="exercise_form_save_failed">Could not save the exercise. Try again.</string>

    <!-- ── Exercise detail ────────────────────────────────────────────────────────── -->

    <string name="detail_back">Back</string>
    <string name="detail_edit">Edit exercise</string>
    <string name="detail_delete">Delete exercise</string>

    <string name="detail_section_muscles">Muscles worked</string>
    <!-- "How to" rather than "Instructions": it is the bundled dataset's own wording for a
         list of steps, and the shorter heading leaves room for the rule beside it. -->
    <string name="detail_section_instructions">How to</string>
    <!-- Deliberately distinct from the section above. `Exercise.instructions` is the same for
         everybody; `Exercise.notes` is the user's own. -->
    <string name="detail_section_notes">Your notes</string>

    <string name="detail_muscles_primary">Primary</string>
    <string name="detail_muscles_secondary">Secondary</string>
    <!-- Announced as one phrase: "Primary, Chest" rather than a badge and a list read apart. -->
    <string name="detail_muscles_description">%1$s, %2$s</string>
    <!-- Quoted: Android trims unquoted whitespace, which would join the names up. -->
    <string name="detail_muscle_separator">", "</string>

    <!-- The metadata cells. "Type" for the discipline, because that is the word a lifter uses
         for what kind of exercise something is; "Tracked" says what a set of it records. -->
    <string name="detail_meta_discipline">Type</string>
    <string name="detail_meta_equipment">Equipment</string>
    <string name="detail_meta_mechanic">Mechanic</string>
    <string name="detail_meta_difficulty">Difficulty</string>
    <string name="detail_meta_tracked">Tracked</string>

    <!-- The two jumps off the screen. Neither destination exists yet (#95, M5), so neither
         button is drawn — the strings land with the screen that draws them. -->
    <string name="detail_plate_calculator">Plate calculator</string>
    <string name="detail_progression">Progression</string>

    <string name="detail_add_to_session">Add to session</string>

    <string name="detail_notes_label">Your notes</string>
    <string name="detail_notes_empty">Add a note about this exercise — a seat setting, a cue, which machine at your gym.</string>
    <string name="detail_notes_add">Add a note</string>
    <string name="detail_notes_edit">Edit the note</string>
    <string name="detail_notes_cancel">Cancel</string>
    <string name="detail_notes_save">Save</string>
    <string name="detail_notes_save_failed">Could not save the note</string>

    <string name="detail_exercise_updated">Exercise updated</string>
    <string name="detail_exercise_save_failed">Could not save the exercise</string>

    <string name="detail_delete_title">Delete this exercise?</string>
    <string name="detail_delete_body">%1$s will be removed from your library. It can only be deleted while no logged session or template still uses it.</string>
    <string name="detail_delete_confirm">Delete</string>
    <string name="detail_delete_cancel">Cancel</string>
    <string name="detail_delete_failed">Could not delete the exercise</string>

    <!-- The glyph is drawn text, not an icon — the design's marks are typographic. -->
    <string name="detail_glyph_missing">☐</string>
    <string name="detail_missing_title">Exercise not found</string>
    <string name="detail_missing_description">This exercise is no longer in your library.</string>

    <!-- ── Plate calculator ───────────────────────────────────────────────────────── -->

    <string name="plate_title">Plate calculator</string>
    <string name="plate_back">Back</string>

    <!-- The big figure. Announced with the weight in it, because the number itself is drawn
         as digits and a suffix and would otherwise be read as two unrelated nodes. -->
    <string name="plate_target">Target weight</string>
    <string name="plate_target_edit">Target weight, %1$s. Tap to type one</string>
    <string name="plate_target_field_label">Weight (%1$s)</string>
    <string name="plate_target_invalid">Enter a weight above zero</string>

    <!-- The heading over the barbell. The bar is named here because everything below it is
         "per side", and a lifter reading the plates needs to know what they are added to. -->
    <string name="plate_per_side_bar">Per side · bar %1$s</string>

    <!-- The line that keeps the big number honest — see PlateCalculatorScreen. -->
    <string name="plate_shortfall">Loads to %1$s · %2$s short of your target</string>
    <string name="plate_below_bar">Lighter than the empty %1$s bar</string>

    <!-- The equipment editor. -->
    <string name="plate_equipment">Bar &amp; plates</string>
    <string name="plate_equipment_bar">Bar</string>
    <string name="plate_equipment_plates">Plates · pairs on the rack</string>
    <string name="plate_equipment_reset">Use the standard set</string>
    <string name="plate_bar_lighter">Lighter bar</string>
    <string name="plate_bar_heavier">Heavier bar</string>
    <string name="plate_pairs_fewer">One fewer pair of %1$s</string>
    <string name="plate_pairs_more">One more pair of %1$s</string>

    <string name="plate_dialog_save">Set</string>
    <string name="plate_dialog_cancel">Cancel</string>
    <string name="plate_save_failed">Could not save your equipment</string>

</resources>
