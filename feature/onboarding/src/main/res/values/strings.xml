<?xml version="1.0" encoding="utf-8"?>
<!--
  The first-run flow.

  Five screens' worth of copy, and the one place in the app where the reader has not decided
  yet whether to trust it. So: no exclamation marks, no promises the app does not keep — the
  goal and the level feed one thing, the next-load suggestion, and the copy says that rather
  than claiming tailored plans — and no sentence longer than one held in the head between sets.

  The goal, level and unit-system option labels are *not* here. They live in `:core:ui`
  (`PreferenceLabels.kt`) because settings asks the same three questions, and one stored value
  described two ways is worse than a shared string.
-->
<resources>

    <!-- ── Chrome ─────────────────────────────────────────────────────────────────── -->

    <!-- The step counter, drawn as an eyebrow: "STEP 2 OF 5". Written "of" rather than the
         wireframe's slash so a screen reader says it as a sentence rather than as punctuation. -->
    <string name="onboarding_step_counter">Step %1$d of %2$d</string>
    <string name="onboarding_skip">Skip</string>
    <!-- The visible way back a step. The system gesture does the same thing, but a gesture is
         not an affordance: without this the flow only ever looked as if it went one way. -->
    <string name="onboarding_back">Back</string>
    <string name="onboarding_continue">Continue</string>
    <string name="onboarding_start">Start training</string>

    <!-- ── Welcome ───────────────────────────────────────────────────────────────── -->

    <string name="onboarding_welcome_title">Log the work. Watch it add up.</string>
    <string name="onboarding_welcome_body">Titan is a training log that runs entirely on this phone. No account, no cloud, no ads.</string>
    <string name="onboarding_welcome_logging">Log sets</string>
    <string name="onboarding_welcome_logging_detail">Weight, reps and RPE, one tap per set</string>
    <string name="onboarding_welcome_progress">See progress</string>
    <string name="onboarding_welcome_progress_detail">Volume, records and a training calendar</string>
    <string name="onboarding_welcome_privacy">Keep it yours</string>
    <string name="onboarding_welcome_privacy_detail">Everything stays on this device</string>
    <string name="onboarding_welcome_length">Three questions, then you are in</string>

    <!-- ── Training goal ─────────────────────────────────────────────────────────── -->

    <string name="onboarding_goal_title">What are you training for?</string>
    <!-- Deliberately modest. The goal picks the rep range a suggested next load aims for
         (#M7-15) and nothing else, and a first-run screen promising tailored plans is the
         wrong place to start being wrong. -->
    <string name="onboarding_goal_body">Sets the rep range the app suggests your next load in. Kept with your settings, and changeable any time.</string>

    <!-- ── Fitness level ─────────────────────────────────────────────────────────── -->

    <!-- Asked as time, not as strength: "how long" is a question anybody can answer on a
         first screen, where a strength standard is one the reader this app is for would
         guess at. The level paces how quickly suggested loads go up (#M7-15). -->
    <string name="onboarding_level_title">How long have you been training?</string>
    <string name="onboarding_level_body">Paces how quickly suggested loads go up. Kept with your settings, and changeable any time.</string>

    <!-- ── Units ─────────────────────────────────────────────────────────────────── -->

    <string name="onboarding_units_title">Kilos or pounds?</string>
    <string name="onboarding_units_body">How weights and distances are shown. Every set is stored the same way either way, so switching later changes nothing you have logged.</string>

    <!-- ── Ready ─────────────────────────────────────────────────────────────────── -->

    <string name="onboarding_ready_title">You are set.</string>
    <string name="onboarding_ready_body">That is everything. Your first workout is one tap from the home screen.</string>
    <string name="onboarding_ready_goal">Training goal</string>
    <string name="onboarding_ready_level">Fitness level</string>
    <string name="onboarding_ready_units">Units</string>
    <string name="onboarding_ready_footnote">All three live in Settings, along with everything else.</string>
    <!-- How one recap row is read out: "Training goal, Hypertrophy". A label and a value
         announced as two fragments are two facts a swipe apart, which is not the same
         information — the same sentence `MetaGrid` builds for the metadata blocks elsewhere. -->
    <string name="onboarding_ready_recap_description">%1$s, %2$s</string>

    <!-- ── Failures ──────────────────────────────────────────────────────────────── -->

    <string name="onboarding_save_failed">Could not save that answer</string>
    <string name="onboarding_finish_failed">Could not finish setting up. Check this phone\'s storage and try again.</string>

</resources>
