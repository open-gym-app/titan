<?xml version="1.0" encoding="utf-8"?>
<!--
  Strings for the shared workout components.

  Anything a screen reader announces lives here rather than in a feature module: the
  components are the things being announced, and a content description that lived at the call
  site would be written once per screen and drift four ways.

  Labels are written in sentence case even where the design draws them uppercase. The
  `Eyebrow` and `OpenGymBadge` components uppercase for the caller, so a translator is never
  asked to reproduce a typographic treatment.
-->
<resources>

    <!-- ── Set logging ────────────────────────────────────────────────────────────── -->

    <string name="set_log_column_set">Set</string>
    <string name="set_log_column_previous">Prev</string>
    <!-- The combined weight-and-reps column: "KG × REPS". The unit is the ambient one. -->
    <string name="set_log_column_reps">Reps</string>
    <string name="set_log_column_rpe">RPE</string>

    <!-- Set types. The marker is the single glyph shown in the set-number cell; the label is
         what a screen reader says, what a badge spells out, and what the type menu lists.
         "Standard set" rather than "working set": a working set and a warm-up both begin with W,
         which is a collision in a menu of five and worse next to a cell whose whole job is to
         draw one letter. Only the wording changes — SetType.NORMAL is what is stored. -->
    <string name="set_type_normal">Standard set</string>
    <string name="set_type_warmup">Warm-up</string>
    <string name="set_type_warmup_marker">W</string>
    <string name="set_type_drop">Drop set</string>
    <string name="set_type_drop_marker">D</string>
    <string name="set_type_failure">To failure</string>
    <string name="set_type_failure_marker">F</string>
    <string name="set_type_interval">Interval</string>
    <string name="set_type_interval_marker">I</string>

    <!-- Announced for the set-number cell: "Warm-up, set 1". -->
    <string name="set_log_position">%1$s, set %2$d</string>
    <string name="set_log_weight_field">Weight, set %1$d</string>
    <string name="set_log_reps_field">Reps, set %1$d</string>
    <!-- The RPE cell folds its value into the description, the way every other cell does: a
         content description replaces the text it is set on rather than adding to it, so a
         label alone would announce the column and swallow the number. -->
    <string name="set_log_rpe_value">Rate of perceived exertion, set %1$d, %2$s</string>
    <string name="set_log_rpe_none">Rate of perceived exertion, set %1$d, not set</string>
    <string name="set_log_rpe_unset" translatable="false">–</string>
    <!-- Drawn in the previous column when a set has no history, so the columns of one table
         still line up. Hidden from screen readers: it is a spacer, not a value. -->
    <string name="set_log_previous_none" translatable="false">–</string>
    <string name="set_log_previous_value">Previously %1$s</string>
    <!-- The tick: its label, and its two states as a screen reader says them before the
         label — "Completed, Set 3, checkbox". It is the same control on the row being typed
         and on a set already written: the first logs the set, and on a logged row it takes the
         tick back off one that was pressed by accident. -->
    <string name="set_log_completion">Set %1$d</string>
    <string name="set_log_completed">Completed</string>
    <string name="set_log_not_completed">Not completed</string>
    <string name="set_log_weight_and_reps">%1$s × %2$d</string>
    <!-- A bodyweight set, where the count is the whole of what was done. A plural because a
         set of one is a rep: "1 reps" is the first set of every workout reading wrong. -->
    <plurals name="set_log_reps_only">
        <item quantity="one">%1$d rep</item>
        <item quantity="other">%1$d reps</item>
    </plurals>
    <!-- The same set squeezed into the previous column: "60×10", no unit and no spaces. The
         column is 52dp wide between two fields, and the row's own header says which unit the
         numbers are in. -->
    <string name="set_log_weight_and_reps_compact">%1$s×%2$d</string>
    <string name="set_log_reps_only_compact">×%1$d</string>

    <!-- ── Correcting a logged set ────────────────────────────────────────────────── -->

    <!-- Nothing here names an editor, a save or a cancel: a logged set is corrected by typing
         into the row it is already in, and the correction is written when the row is left. -->

    <!-- The accessibility action that stands in for the swipe, since a gesture is not an
         affordance a screen reader can reach. Names the set, because a table of five would
         otherwise offer five identical actions. -->
    <string name="set_delete_action">Delete set %1$d</string>

    <!-- ── The next target ────────────────────────────────────────────────────────── -->

    <!-- The line under the entry row that says what the next set should be (#M7-16): the
         figures, and beside them how far the weight moved from last time. The whole line is
         one button — tapping it fills the fields above — so it is read as one sentence: the
         figures, then the reason, then the action. -->
    <string name="set_target_line">Target %1$s</string>
    <string name="set_target_with_change" translatable="false">%1$s · %2$s</string>
    <!-- The change with its sign, since the figure beside it carries none: "+2.5 kg", "−5 kg".
         A resource rather than a glyph in code so a translator can move the sign. -->
    <string name="set_target_gain">+%1$s</string>
    <string name="set_target_loss">−%1$s</string>
    <string name="set_target_description" translatable="false">%1$s. %2$s</string>
    <string name="set_target_fill_action">Fill in the target</string>

    <!-- Why the target is what it is, one line per rule, written as advice rather than as the
         rule's name — see SuggestionReason. The increase and the deload quote the step the
         weight moves by; the bodyweight deload has no weight to take off. -->
    <string name="suggestion_reason_increase">Hit the top of the range last time — add %1$s</string>
    <string name="suggestion_reason_add_rep">Inside the range last time — one more rep</string>
    <string name="suggestion_reason_repeat">Hit the top of the range once — hit it again to earn the increase</string>
    <string name="suggestion_reason_deload">Fell short last time — take %1$s off and rebuild</string>
    <string name="suggestion_reason_deload_bodyweight">Fell short last time — start again at the bottom of the range</string>

    <!-- Announced for the leading cell when the type can be changed: "Set type, set 3,
         Warm-up". The value is folded in for the reason the RPE cell folds its own in. -->
    <string name="set_type_field">Set type, set %1$d, %2$s</string>

    <!-- The RPE scale, as a menu rather than a field — see RpePicker. The cell draws the rating
         alone; this is what a screen reader says of one, since "8.5" on its own names no
         quantity. -->
    <string name="rpe_value">Rate of perceived exertion %1$s</string>
    <!-- The way back to an unrated set, and the last item in the menu: it is the way out of a
         rating rather than one of the ratings. -->
    <string name="rpe_not_rated">Not rated</string>
    <!-- Above the ratings in the menu. The two anchors are what make the numbers mean anything
         to somebody meeting them for the first time; the rest of the scale interpolates. -->
    <string name="rpe_scale_hint">10 is nothing left in the tank, 8 is two more reps.</string>

    <!-- ── The active session's header ────────────────────────────────────────────── -->

    <!-- The running clock, said rather than spelled: read as text it is digits with no noun
         near them. -->
    <string name="session_elapsed">Elapsed %1$s</string>
    <string name="session_elapsed_paused">Paused at %1$s</string>
    <!-- The progress rail, which is drawn as one sliver per exercise and announced as one
         sentence — see SessionProgressRail. -->
    <plurals name="session_progress">
        <item quantity="one">%1$d of %2$d exercise done</item>
        <item quantity="other">%1$d of %2$d exercises done</item>
    </plurals>
    <string name="session_header_pause">Pause the session</string>
    <string name="session_header_resume">Resume the session</string>
    <string name="session_header_discard">Discard the session</string>
    <!-- Says the word drawn on the button: a Voice Access user says what they see, and a
         button that reads "End" but answers to "Finish" is one they cannot press. -->
    <string name="session_header_finish">End the session</string>
    <!-- Drawn on the button. Short because the bar holds three controls and a clock. -->
    <string name="session_header_finish_label">End</string>
    <!-- The header's name doubles as the way to change it. -->
    <string name="session_header_rename">Rename this workout</string>
    <!-- The name and the clock as one announcement, where the title block is the rename
         control — see SessionTitle. %1$s the name, %2$s the spoken clock. -->
    <string name="session_header_title">%1$s, %2$s</string>

    <!-- ── Naming a session ──────────────────────────────────────────────────────── -->

    <!-- One dialog, used before a session starts, during it and afterwards. -->
    <string name="session_name_title">Name this workout</string>
    <!-- The field has no drawn label — the dialog's title is what names it — so this is what
         a screen reader reads for it. -->
    <string name="session_name_label">Session name</string>
    <string name="session_name_placeholder">Push day · Upper</string>
    <!-- Says that clearing the field is a real answer, since the confirm button stays live
         on an empty one and would otherwise look broken. -->
    <string name="session_name_hint">Leave it empty to go by the date instead.</string>
    <string name="session_name_confirm">Save</string>
    <string name="session_name_cancel">Cancel</string>

    <!-- ── Exercises ──────────────────────────────────────────────────────────────── -->

    <string name="exercise_last_performed">Last %1$s</string>
    <string name="exercise_never_performed">Not logged yet</string>
    <!-- Quoted: Android trims unquoted leading and trailing whitespace, which turns
         "Chest, Triceps" into "Chest,Triceps". -->
    <string name="exercise_meta_separator">" · "</string>

    <!-- How an exercise is measured — named after what the user logs, not after the enum
         constant. Mirrors ExerciseType. -->
    <string name="exercise_type_strength">Weight &amp; reps</string>
    <string name="exercise_type_endurance">Distance &amp; time</string>
    <string name="exercise_type_isometric">Hold</string>

    <!-- The same fact spelled out: the fields a set of this exercise is logged with. RPE is
         on all three because the set row always offers it, not because a hold is graded the
         way a heavy triple is. -->
    <string name="exercise_tracked_strength">Weight, reps, RPE</string>
    <string name="exercise_tracked_endurance">Distance, time, RPE</string>
    <string name="exercise_tracked_isometric">Time, RPE</string>

    <!-- Whether the movement is a compound or an isolation. Mirrors MechanicType; the seed
         leaves the column unset for stretches and carries. -->
    <string name="mechanic_compound">Compound</string>
    <string name="mechanic_isolation">Isolation</string>

    <!-- How much practice the movement demands. A grading of the exercise, not of the
         reader. Mirrors DifficultyLevel. -->
    <string name="difficulty_beginner">Beginner</string>
    <string name="difficulty_intermediate">Intermediate</string>
    <string name="difficulty_expert">Expert</string>

    <!-- The tradition the movement comes from. Mirrors Discipline, which is not the same
         question as ExerciseType: five of these are all logged as weight and reps. -->
    <string name="discipline_strength">Strength</string>
    <string name="discipline_powerlifting">Powerlifting</string>
    <string name="discipline_olympic_weightlifting">Olympic lifting</string>
    <string name="discipline_strongman">Strongman</string>
    <string name="discipline_plyometrics">Plyometrics</string>
    <string name="discipline_stretching">Stretching</string>
    <string name="discipline_cardio">Cardio</string>

    <!-- Equipment. Mirrors EquipmentType; OTHER has no label because "Other" beside an
         exercise name says nothing the name did not. -->
    <string name="equipment_barbell">Barbell</string>
    <string name="equipment_dumbbell">Dumbbell</string>
    <string name="equipment_machine">Machine</string>
    <string name="equipment_bodyweight">Bodyweight</string>
    <string name="equipment_cable">Cable</string>
    <string name="equipment_kettlebell">Kettlebell</string>
    <string name="equipment_band">Band</string>
    <string name="equipment_ez_curl_bar">EZ bar</string>
    <string name="equipment_medicine_ball">Medicine ball</string>
    <string name="equipment_exercise_ball">Exercise ball</string>
    <string name="equipment_foam_roll">Foam roller</string>

    <!-- Muscle groups, keyed off the seeded taxonomy in tools/seed/generate_seed.py. A group
         the seed does not know (a user-authored one) falls back to its own stored name. -->
    <string name="muscle_abdominals">Abs</string>
    <string name="muscle_abductors">Abductors</string>
    <string name="muscle_adductors">Adductors</string>
    <string name="muscle_biceps">Biceps</string>
    <string name="muscle_calves">Calves</string>
    <string name="muscle_chest">Chest</string>
    <string name="muscle_forearms">Forearms</string>
    <string name="muscle_glutes">Glutes</string>
    <string name="muscle_hamstrings">Hamstrings</string>
    <string name="muscle_lats">Lats</string>
    <string name="muscle_lower_back">Lower back</string>
    <string name="muscle_middle_back">Mid back</string>
    <string name="muscle_neck">Neck</string>
    <string name="muscle_quadriceps">Quads</string>
    <string name="muscle_shoulders">Shoulders</string>
    <string name="muscle_traps">Traps</string>
    <string name="muscle_triceps">Triceps</string>

    <!-- ── Templates ──────────────────────────────────────────────────────────────── -->

    <!-- What a saved template trains. Mirrors TemplateCategory; there is no label for the
         absent category, which means the user was never asked rather than "General". -->
    <string name="template_category_strength">Strength</string>
    <string name="template_category_hypertrophy">Hypertrophy</string>
    <string name="template_category_endurance">Endurance</string>
    <string name="template_category_mobility">Mobility</string>
    <string name="template_category_general">General</string>

    <!-- A template row's figures: "8 ex · ~55m". Abbreviated because the line is set in the
         mono numeric role under the name, where "8 exercises" is twice the width and says
         nothing more. The spoken forms below are the ones with the words in. -->
    <plurals name="template_exercise_count">
        <item quantity="one">%1$d ex</item>
        <item quantity="other">%1$d ex</item>
    </plurals>
    <string name="template_meta">%1$s · %2$s</string>

    <!-- Announced for a template row as one sentence — see TemplateRow. -->
    <plurals name="template_exercise_count_description">
        <item quantity="one">%1$d exercise</item>
        <item quantity="other">%1$d exercises</item>
    </plurals>
    <plurals name="template_description_duration">
        <item quantity="one">%1$s, about %2$d minute</item>
        <item quantity="other">%1$s, about %2$d minutes</item>
    </plurals>
    <string name="template_description">%1$s, %2$s</string>
    <string name="template_description_category">%1$s, %2$s, %3$s</string>

    <!-- What tapping a quick-start card does, as the click's own label. -->
    <string name="template_start">Start from this template</string>

    <!-- The category picker's own chrome. "None" is a chip rather than the absence of one —
         see TemplateCategoryPicker — so it needs a word of its own. -->
    <string name="template_category_label">Category</string>
    <string name="template_category_none">None</string>

    <!-- Naming a template: saving a workout as one, renaming it, retitling it in the editor.
         The field has no drawn label — the dialog's title names it — so this is what a screen
         reader reads for it. -->
    <string name="template_name_label">Template name</string>
    <string name="template_name_placeholder">Push day · Upper</string>
    <string name="template_name_cancel">Cancel</string>

    <!-- ── Supersets ──────────────────────────────────────────────────────────────── -->

    <!-- The marker an exercise in a superset wears: "SS A1". Abbreviated because it sits on a
         badge beside an exercise's name; the spoken forms below carry the words. -->
    <string name="superset_badge">SS %1$s</string>
    <!-- The join between two exercises, as an offer and as a fact. -->
    <string name="superset_link_label">Superset</string>
    <string name="superset_linked_label">Superset %1$s</string>
    <string name="superset_link">Perform %1$s and %2$s back to back</string>
    <string name="superset_break">Stop performing %1$s and %2$s back to back</string>
    <!-- What the join announces: the label drawn on the pill, then what a press does.
         "Superset A. Stop performing Bench press and Cable fly back to back." The drawn word
         leads so the control answers to the name a user can read off it. -->
    <string name="superset_description">%1$s. %2$s</string>

    <!-- ── Rest timer ─────────────────────────────────────────────────────────────── -->

    <string name="rest_timer_running">Rest</string>
    <string name="rest_timer_paused">Rest paused</string>
    <string name="rest_timer_finished">Rest complete</string>
    <string name="rest_timer_idle">No rest running</string>
    <string name="rest_timer_of_total">of %1$s</string>
    <string name="rest_timer_remaining">%1$s left</string>
    <!-- What the live region says while the rest runs, four times a minute: the time left to
         the quarter-minute above it — see RestTimerState.announcement(). -->
    <string name="rest_timer_live_running">Resting, %1$s left</string>
    <string name="rest_timer_live_paused">Rest paused, %1$s left</string>
    <string name="rest_timer_up_next">Next %1$s</string>
    <string name="rest_timer_shorter_label">−%1$ds</string>
    <string name="rest_timer_shorter">Shorten the rest by %1$d seconds</string>
    <string name="rest_timer_longer_label">+%1$ds</string>
    <string name="rest_timer_longer">Extend the rest by %1$d seconds</string>
    <string name="rest_timer_pause">Pause the rest</string>
    <string name="rest_timer_resume">Resume the rest</string>
    <string name="rest_timer_skip">Skip rest</string>
    <string name="rest_timer_next_set">Next set</string>
    <string name="rest_timer_reopen">Show the rest timer</string>

    <!-- ── Stats ──────────────────────────────────────────────────────────────────── -->

    <string name="stat_volume">Volume</string>
    <string name="stat_sets">Sets</string>
    <!-- Inside a chip, where it follows the figure in a phrase rather than heading it. A plural
         with no placeholder: the figure is drawn beside this rather than into it, because a
         chip sets the number and its word in two different colours — but the word still has to
         agree with the number, or the first set of a workout reads "1 sets". -->
    <plurals name="stat_sets_short">
        <item quantity="one">set</item>
        <item quantity="other">sets</item>
    </plurals>
    <string name="stat_sets_unit">total</string>
    <string name="stat_duration">Duration</string>
    <string name="stat_exercises">Exercises</string>
    <string name="stat_exercises_unit">done</string>
    <!-- The tile a session summary shows instead of the duration, which its own header
         already carries. -->
    <string name="stat_muscles">Muscles</string>
    <string name="stat_muscles_unit">worked</string>
    <!-- Announced as one phrase so TalkBack says "Volume, 4,820 kg" rather than reading a
         label and a number as two unrelated nodes. A tile's label leads, as its eyebrow does;
         a chip's figure leads, as the pill reads - see `figure_with_unit`. -->
    <string name="stat_description">%1$s, %2$s</string>

    <!-- Personal records. PrType's own names, as a lifter would say them. -->
    <string name="pr_badge">PR</string>
    <string name="pr_max_weight">Heaviest</string>
    <string name="pr_max_reps">Most reps</string>
    <string name="pr_max_volume">Most volume</string>
    <string name="pr_estimated_1rm">1RM</string>
    <string name="pr_max_distance">Furthest</string>
    <string name="pr_best_pace">Best pace</string>
    <!-- Opens with the badge's own letters. "PR" is what a lifter says and what is drawn,
         and a label that starts with the drawn text is one Voice Access matches; the words
         the abbreviation stands for follow it. -->
    <string name="pr_description">PR %1$s, personal record</string>
    <string name="pr_description_short">PR, personal record</string>
    <!-- A record's figure where the kind has no unit of its own to carry it. -->
    <!-- A rep record's unit. The figure beside it comes from `formattedFigure`, which goes
         through the package's own number formatter so the digits follow the device locale. -->
    <plurals name="pr_unit_reps">
        <item quantity="one">rep</item>
        <item quantity="other">reps</item>
    </plurals>
    <!-- Announced for a record shown as a bare figure: "Personal record, heaviest, 92 kg". -->
    <string name="pr_value_description">Personal record, %1$s, %2$s</string>

    <!-- ── Notes ─────────────────────────────────────────────────────────────────── -->

    <!-- The pencil's description, which says what pressing it does rather than what is under
         it — and that is not the same for a note that has not been written yet. The prompt
         shown in place of an absent note is the caller's, because it is the one part that
         differs between an exercise and a session. -->
    <string name="notes_add">Add a note</string>
    <string name="notes_edit">Edit the note</string>
    <string name="notes_save">Save</string>
    <string name="notes_cancel">Cancel</string>

    <!-- ── Reordering ─────────────────────────────────────────────────────────────── -->

    <!-- Offered as actions on every item of a reorderable list. A drag is a gesture TalkBack
         cannot perform, so the same two moves are always reachable without one. -->
    <string name="reorder_move_up">Move up</string>
    <string name="reorder_move_down">Move down</string>
    <!-- A collapsed item, read as one line: "3. Cable fly". The handle, the number and the
         name are three stops in the traversal order and none means anything on its own. -->
    <string name="reorder_position">%1$d. %2$s</string>

    <!-- ── Search ─────────────────────────────────────────────────────────────────── -->

    <string name="search_placeholder">Search…</string>
    <string name="search_clear">Clear the search</string>

    <!-- ── Plates ─────────────────────────────────────────────────────────────────── -->

    <!-- The barbell diagram is announced as one sentence rather than as a dozen plates. -->
    <string name="plate_diagram_loaded">Barbell loaded with %1$s per side</string>
    <string name="plate_diagram_empty">Barbell with no plates on it</string>
    <!-- Quoted: Android trims unquoted whitespace, which runs the two plates together. -->
    <string name="plate_list_separator">", "</string>
    <!-- Spelled out rather than announced as "2 times 20 kg": the multiplication sign in the
         legend is a typographic convention, not something to read aloud. -->
    <plurals name="plate_count_description">
        <item quantity="one">%1$d plate of %2$s</item>
        <item quantity="other">%1$d plates of %2$s</item>
    </plurals>

    <string name="plate_legend_per_side">Per side</string>
    <!-- The count beside a legend row's weight. The description carries the words. -->
    <string name="plate_legend_count">× %1$d</string>

    <!-- ── Body diagram ───────────────────────────────────────────────────────────── -->

    <string name="body_view_front">Front</string>
    <string name="body_view_back">Back</string>
    <string name="body_muscles_worked">Muscles worked</string>
    <string name="body_diagram_none">Body diagram. No muscles highlighted.</string>
    <string name="body_diagram_primary">Body diagram. Worked directly: %1$s.</string>
    <string name="body_diagram_primary_and_secondary">Body diagram. Worked directly: %1$s. Also worked: %2$s.</string>
    <string name="body_diagram_secondary">Body diagram. Worked indirectly: %1$s.</string>
    <string name="body_muscle_separator">", "</string>

    <!-- ── Muscle contribution ────────────────────────────────────────────────────── -->

    <!-- A bar in the muscle breakdown, announced as one phrase: the muscle, the volume
         attributed to it, and which of the two tones the bar is drawn in. The bar's *length*
         is not spoken: it is relative to the hardest-worked muscle rather than a share of
         anything, and a percentage read aloud would claim a whole that does not exist. -->
    <string name="muscle_contribution_description_primary">%1$s, %2$s, worked directly</string>
    <string name="muscle_contribution_description_secondary">%1$s, %2$s, also worked</string>

    <!-- ── Sessions ──────────────────────────────────────────────────────────────── -->

    <!-- A session row's set count: "12 sets", in the mono line under the name. Abbreviated
         nowhere — "sets" is already the short word — but kept as a plural so a session with
         one set does not read "1 sets". -->
    <plurals name="session_set_count">
        <item quantity="one">%1$d set</item>
        <item quantity="other">%1$d sets</item>
    </plurals>
    <!-- The same count inside the row's spoken sentence, where "sets" needs no context. -->
    <plurals name="session_set_count_description">
        <item quantity="one">%1$d set</item>
        <item quantity="other">%1$d sets</item>
    </plurals>

    <!-- ── Training calendar ─────────────────────────────────────────────────────── -->

    <!-- One cell, announced as its date and what was done on it. The shade is not spoken:
         it is relative to the month rather than an absolute figure, so "heavy" read aloud
         would claim a comparison that does not survive turning the page. -->
    <plurals name="calendar_day_sessions">
        <item quantity="one">%1$s, %2$d session</item>
        <item quantity="other">%1$s, %2$d sessions</item>
    </plurals>
    <string name="calendar_day_rest">%1$s, rest day</string>
    <!-- A day the week has not reached. Distinct from a rest day on purpose: nobody has
         skipped a workout they have not had the chance to do yet. -->
    <string name="calendar_day_upcoming">%1$s, upcoming</string>
    <!-- What tapping a trained day does, as the click's own label. -->
    <string name="calendar_day_open">Show this day</string>

    <!-- ── Discarding a session ───────────────────────────────────────────────────── -->

    <!-- The discard confirmation, asked by the workout screen and by the home screen's
         resume banner. The count is in the question because "discard this session?" is a
         different question when the answer costs eleven sets. -->
    <string name="discard_session_title">Discard this workout?</string>
    <plurals name="discard_session_body">
        <item quantity="one">%1$d logged set will be deleted. This cannot be undone.</item>
        <item quantity="other">%1$d logged sets will be deleted. This cannot be undone.</item>
    </plurals>
    <string name="discard_session_body_empty">Nothing has been logged yet, so nothing will be lost.</string>
    <string name="discard_session_confirm">Discard</string>
    <string name="discard_session_cancel">Keep training</string>

    <!-- ── Charts ────────────────────────────────────────────────────────────────── -->

    <!-- A chart as one sentence, so a screen reader reaches the shape, the range and the
         latest value without walking twelve marks. The clauses are ordered by the format
         string rather than concatenated in Kotlin, so a translation may reorder them. -->
    <string name="chart_description">%1$s, %2$s to %3$s. Latest %4$s. Highest %5$s in %6$s, lowest %7$s in %8$s.</string>
    <!-- Every period the same. One clause rather than "highest X, lowest X", which is two
         sentences restating one fact. -->
    <string name="chart_description_flat">%1$s, %2$s to %3$s. %4$s throughout, unchanged.</string>
    <!-- Fewer than two marks: there is no trend, and saying so beats saying nothing about a
         card the user can see is empty. -->
    <string name="chart_description_empty">%1$s. Not enough to chart yet.</string>
    <!-- Drawn in the middle of a chart that has nothing to plot. -->
    <string name="chart_placeholder">Not enough to chart yet</string>

    <!-- The change against the previous period. The arrow is drawn and the word is spoken:
         an arrow character read aloud before a number is not a sentence. -->
    <string name="chart_change_up">\u2191 %1$s</string>
    <string name="chart_change_down">\u2193 %1$s</string>
    <string name="chart_change_up_description">Up %1$s on the previous period</string>
    <string name="chart_change_down_description">Down %1$s on the previous period</string>
    <!-- The figure leads because it is what the chip draws: "0 kg, unchanged". -->
    <string name="chart_change_none_description">%1$s, unchanged on the previous period</string>

    <!-- The XP ring, announced as its label, its fraction and how far round it has gone. -->
    <string name="progress_ring_description">%1$s, %2$s, %3$d%% complete</string>
    <!-- The laurel wreath the quest log draws a rank in. Same shape of sentence as the
         ring above: a wreath is an award rather than a chart, but it still reports a value. -->
    <string name="laurel_wreath_description">%1$s, %2$s, %3$d%% complete</string>

    <!-- ── Stored preferences ────────────────────────────────────────────────────── -->

    <!-- The settings the user is asked about in more than one place: onboarding asks for the
         goal, the level and the units on first launch, and settings offers them all for the
         rest of the app's life. The words live here, next to the labels for the domain's
         other enums, so the two screens cannot describe the same stored value differently. -->

    <string name="preference_theme_light">Light</string>
    <string name="preference_theme_dark">Dark</string>
    <string name="preference_theme_system">Auto</string>
    <string name="preference_theme_system_detail">Follows your device</string>

    <string name="preference_units_metric">Metric</string>
    <string name="preference_units_metric_detail">Kilograms and kilometres</string>
    <string name="preference_units_imperial">Imperial</string>
    <string name="preference_units_imperial_detail">Pounds and miles</string>

    <string name="preference_goal_strength">Strength</string>
    <string name="preference_goal_strength_detail">Heavy, low reps, long rests</string>
    <string name="preference_goal_hypertrophy">Hypertrophy</string>
    <string name="preference_goal_hypertrophy_detail">Volume and time under tension</string>
    <string name="preference_goal_endurance">Endurance</string>
    <string name="preference_goal_endurance_detail">High reps, short rests</string>
    <string name="preference_goal_custom">Custom</string>
    <string name="preference_goal_custom_detail">Your own programme</string>

    <!-- The fitness level, in the user's terms: how long they have trained, never what they
         can lift. `FitnessLevel`, not the exercise catalogue's `DifficultyLevel` — the two
         nearly share their names and are about different things, see the enum. -->
    <string name="preference_level_beginner">Beginner</string>
    <string name="preference_level_beginner_detail">Under a year of training</string>
    <string name="preference_level_intermediate">Intermediate</string>
    <string name="preference_level_intermediate_detail">One to three years</string>
    <string name="preference_level_advanced">Advanced</string>
    <string name="preference_level_advanced_detail">More than three years</string>

    <string name="preference_one_rep_max_epley">Epley</string>
    <string name="preference_one_rep_max_epley_detail">Simple; overestimates at high reps</string>
    <string name="preference_one_rep_max_brzycki">Brzycki</string>
    <string name="preference_one_rep_max_brzycki_detail">More accurate at low reps</string>

    <!-- ── Preference rows ──────────────────────────────────────────────────────── -->

    <!-- The badge on a row whose feature has not shipped yet. Settings carries a dozen of
         them; the body screen's Health Connect row is the same promise on a second screen. -->
    <string name="preference_soon">Soon</string>
    <!-- Said before the tap rather than after it: leaving the app is worth announcing. -->
    <string name="preference_opens_externally">Opens in your browser</string>

    <!-- ── Reminder schedule ────────────────────────────────────────────────────── -->

    <!-- A set of weekdays, summarised. The three named cases exist because the initials fail
         exactly where the schedule is most ordinary: MTWTFSS is a smear, and nobody parses
         MTWTF as "weekdays". Everything else is drawn as its initials, which carry more than
         a phrase would. -->
    <string name="reminder_days_every">Every day</string>
    <string name="reminder_days_weekdays">Weekdays</string>
    <string name="reminder_days_weekend">Weekends</string>
    <!-- The user has cleared every day out of the schedule. It says so rather than rendering
         nothing, because an empty value column reads as a setting that failed to load. -->
    <string name="reminder_days_none">No days</string>
    <!-- The days and the time on one line: "MWF · 18:00". The same middle dot every other
         two-part value in the app is joined with. -->
    <string name="reminder_schedule">%1$s · %2$s</string>

    <!-- ── Assembled phrases ────────────────────────────────────────────────────── -->

    <!--
      The joins. Every one of these exists because the pieces either side of it are already
      translated and the thing between them is not: a space, a comma and a middle dot all
      belong to a locale, and word order belongs to it too. A translator who needs the unit
      in front of the figure, or a full-width comma, changes these; nothing in Kotlin can be
      changed to give them that.
    -->

    <!-- A figure and what it is measured in, where the two are formatted apart: "4,820 kg",
         "45 reps". A quantity with its unit inside one string comes from the format package
         instead, which asks CLDR for the pattern - see MeasureFormats.kt. -->
    <string name="figure_with_unit">%1$s %2$s</string>
    <!-- The state of a selectable card, said before its label: "Selected, Hypertrophy, radio
         button". See SelectableOption. -->
    <string name="option_selected">Selected</string>
    <string name="option_not_selected">Not selected</string>
    <!-- What joins the clauses of a description a screen reader reads as one node. The
         trailing space is inside the quotes on purpose: XML would otherwise trim it. -->
    <string name="spoken_separator">", "</string>
    <!-- A badge and the thing it qualifies: "PR · 1RM". -->
    <string name="badge_with_qualifier">%1$s · %2$s</string>
    <!-- A card with a heading and a body, announced as one node: "Nothing yet. Log a
         workout." The full stop is part of the join, not of either half. -->
    <string name="title_and_body_description">%1$s. %2$s</string>

    <!-- ── Time picker ──────────────────────────────────────────────────────────── -->

    <!-- The clock face is committed rather than written on every drag — see TimePickerDialog. -->
    <string name="time_picker_confirm">Save</string>
    <string name="time_picker_cancel">Cancel</string>

</resources>
