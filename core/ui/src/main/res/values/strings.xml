<?xml version="1.0" encoding="utf-8"?>
<!--
  Strings for the shared workout components.

  Anything a screen reader announces lives here rather than in a feature module: the
  components are the things being announced, and a content description that lived at the call
  site would be written once per screen and drift four ways.

  Labels are written in sentence case even where the design draws them uppercase. The
  `Eyebrow` and `OpenGymBadge` components uppercase for the caller, so a translator is never
  asked to reproduce a typographic treatment.
-->
<resources>

    <!-- ── Set logging ────────────────────────────────────────────────────────────── -->

    <string name="set_log_column_set">Set</string>
    <string name="set_log_column_previous">Prev</string>
    <!-- The combined weight-and-reps column: "KG × REPS". The unit is the ambient one. -->
    <string name="set_log_column_weight_reps">%1$s × reps</string>
    <string name="set_log_column_rpe">RPE</string>

    <!-- Set types. The marker is the single glyph shown in the set-number cell; the label is
         what a screen reader says and what a badge spells out. -->
    <string name="set_type_normal">Working set</string>
    <string name="set_type_warmup">Warm-up</string>
    <string name="set_type_warmup_marker">W</string>
    <string name="set_type_drop">Drop set</string>
    <string name="set_type_drop_marker">D</string>
    <string name="set_type_failure">To failure</string>
    <string name="set_type_failure_marker">F</string>
    <string name="set_type_interval">Interval</string>
    <string name="set_type_interval_marker">I</string>

    <!-- Announced for the set-number cell: "Warm-up, set 1". -->
    <string name="set_log_position">%1$s, set %2$d</string>
    <string name="set_log_weight_field">Weight, set %1$d</string>
    <string name="set_log_reps_field">Reps, set %1$d</string>
    <!-- The RPE cell folds its value into the description, the way every other cell does: a
         content description replaces the text it is set on rather than adding to it, so a
         label alone would announce the column and swallow the number. -->
    <string name="set_log_rpe_value">Rate of perceived exertion, set %1$d, %2$s</string>
    <string name="set_log_rpe_none">Rate of perceived exertion, set %1$d, not set</string>
    <string name="set_log_rpe_unset">–</string>
    <!-- Drawn in the previous column when a set has no history, so the columns of one table
         still line up. Hidden from screen readers: it is a spacer, not a value. -->
    <string name="set_log_previous_none">–</string>
    <string name="set_log_previous_value">Previously %1$s</string>
    <string name="set_log_mark_done">Mark set %1$d done</string>
    <string name="set_log_mark_not_done">Set %1$d is done. Reopen it</string>
    <string name="set_log_weight_and_reps">%1$s × %2$d</string>
    <string name="set_log_reps_only">%1$d reps</string>

    <!-- The RPE scale, as a picker rather than a field — see RpeSelector. The cells draw the
         rating alone; this is what a screen reader says of one, since "8.5" on its own names
         no quantity. -->
    <string name="rpe_value">Rate of perceived exertion %1$s</string>
    <!-- Under the scale. The two anchors are what make the numbers mean anything to somebody
         meeting them for the first time; the rest of the scale interpolates. -->
    <string name="rpe_scale_hint">10 is nothing left in the tank, 8 is two more reps.</string>

    <!-- ── The active session's header ────────────────────────────────────────────── -->

    <!-- The running clock, said rather than spelled: read as text it is digits with no noun
         near them. -->
    <string name="session_elapsed">Elapsed %1$s</string>
    <string name="session_elapsed_paused">Paused at %1$s</string>
    <!-- The progress rail, which is drawn as one sliver per exercise and announced as one
         sentence — see SessionProgressRail. -->
    <string name="session_progress">%1$d of %2$d exercises done</string>
    <string name="session_header_pause">Pause the session</string>
    <string name="session_header_resume">Resume the session</string>
    <string name="session_header_discard">Discard the session</string>
    <string name="session_header_finish">Finish the session</string>
    <!-- Drawn on the button. Short because the bar holds three controls and a clock. -->
    <string name="session_header_finish_label">End</string>
    <!-- The header's name doubles as the way to change it. -->
    <string name="session_header_rename">Rename this workout</string>

    <!-- ── Naming a session ──────────────────────────────────────────────────────── -->

    <!-- One dialog, used before a session starts, during it and afterwards. -->
    <string name="session_name_title">Name this workout</string>
    <!-- The field has no drawn label — the dialog's title is what names it — so this is what
         a screen reader reads for it. -->
    <string name="session_name_label">Session name</string>
    <string name="session_name_placeholder">Push day · Upper</string>
    <!-- Says that clearing the field is a real answer, since the confirm button stays live
         on an empty one and would otherwise look broken. -->
    <string name="session_name_hint">Leave it empty to go by the date instead.</string>
    <string name="session_name_confirm">Save</string>
    <string name="session_name_cancel">Cancel</string>

    <!-- ── Exercises ──────────────────────────────────────────────────────────────── -->

    <string name="exercise_last_performed">Last %1$s</string>
    <string name="exercise_never_performed">Not logged yet</string>
    <!-- Quoted: Android trims unquoted leading and trailing whitespace, which turns
         "Chest, Triceps" into "Chest,Triceps". -->
    <string name="exercise_meta_separator">" · "</string>

    <!-- How an exercise is measured — named after what the user logs, not after the enum
         constant. Mirrors ExerciseType. -->
    <string name="exercise_type_strength">Weight &amp; reps</string>
    <string name="exercise_type_endurance">Distance &amp; time</string>
    <string name="exercise_type_isometric">Hold</string>

    <!-- The same fact spelled out: the fields a set of this exercise is logged with. RPE is
         on all three because the set row always offers it, not because a hold is graded the
         way a heavy triple is. -->
    <string name="exercise_tracked_strength">Weight, reps, RPE</string>
    <string name="exercise_tracked_endurance">Distance, time, RPE</string>
    <string name="exercise_tracked_isometric">Time, RPE</string>

    <!-- Whether the movement is a compound or an isolation. Mirrors MechanicType; the seed
         leaves the column unset for stretches and carries. -->
    <string name="mechanic_compound">Compound</string>
    <string name="mechanic_isolation">Isolation</string>

    <!-- How much practice the movement demands. A grading of the exercise, not of the
         reader. Mirrors DifficultyLevel. -->
    <string name="difficulty_beginner">Beginner</string>
    <string name="difficulty_intermediate">Intermediate</string>
    <string name="difficulty_expert">Expert</string>

    <!-- The tradition the movement comes from. Mirrors Discipline, which is not the same
         question as ExerciseType: five of these are all logged as weight and reps. -->
    <string name="discipline_strength">Strength</string>
    <string name="discipline_powerlifting">Powerlifting</string>
    <string name="discipline_olympic_weightlifting">Olympic lifting</string>
    <string name="discipline_strongman">Strongman</string>
    <string name="discipline_plyometrics">Plyometrics</string>
    <string name="discipline_stretching">Stretching</string>
    <string name="discipline_cardio">Cardio</string>

    <!-- Equipment. Mirrors EquipmentType; OTHER has no label because "Other" beside an
         exercise name says nothing the name did not. -->
    <string name="equipment_barbell">Barbell</string>
    <string name="equipment_dumbbell">Dumbbell</string>
    <string name="equipment_machine">Machine</string>
    <string name="equipment_bodyweight">Bodyweight</string>
    <string name="equipment_cable">Cable</string>
    <string name="equipment_kettlebell">Kettlebell</string>
    <string name="equipment_band">Band</string>
    <string name="equipment_ez_curl_bar">EZ bar</string>
    <string name="equipment_medicine_ball">Medicine ball</string>
    <string name="equipment_exercise_ball">Exercise ball</string>
    <string name="equipment_foam_roll">Foam roller</string>

    <!-- Muscle groups, keyed off the seeded taxonomy in tools/seed/generate_seed.py. A group
         the seed does not know (a user-authored one) falls back to its own stored name. -->
    <string name="muscle_abdominals">Abs</string>
    <string name="muscle_abductors">Abductors</string>
    <string name="muscle_adductors">Adductors</string>
    <string name="muscle_biceps">Biceps</string>
    <string name="muscle_calves">Calves</string>
    <string name="muscle_chest">Chest</string>
    <string name="muscle_forearms">Forearms</string>
    <string name="muscle_glutes">Glutes</string>
    <string name="muscle_hamstrings">Hamstrings</string>
    <string name="muscle_lats">Lats</string>
    <string name="muscle_lower_back">Lower back</string>
    <string name="muscle_middle_back">Mid back</string>
    <string name="muscle_neck">Neck</string>
    <string name="muscle_quadriceps">Quads</string>
    <string name="muscle_shoulders">Shoulders</string>
    <string name="muscle_traps">Traps</string>
    <string name="muscle_triceps">Triceps</string>

    <!-- ── Templates ──────────────────────────────────────────────────────────────── -->

    <!-- What a saved template trains. Mirrors TemplateCategory; there is no label for the
         absent category, which means the user was never asked rather than "General". -->
    <string name="template_category_strength">Strength</string>
    <string name="template_category_hypertrophy">Hypertrophy</string>
    <string name="template_category_endurance">Endurance</string>
    <string name="template_category_mobility">Mobility</string>
    <string name="template_category_general">General</string>

    <!-- A template row's figures: "8 ex · ~55m". Abbreviated because the line is set in the
         mono numeric role under the name, where "8 exercises" is twice the width and says
         nothing more. The spoken forms below are the ones with the words in. -->
    <plurals name="template_exercise_count">
        <item quantity="one">%1$d ex</item>
        <item quantity="other">%1$d ex</item>
    </plurals>
    <string name="template_meta">%1$s · %2$s</string>

    <!-- Announced for a template row as one sentence — see TemplateRow. -->
    <plurals name="template_exercise_count_description">
        <item quantity="one">%1$d exercise</item>
        <item quantity="other">%1$d exercises</item>
    </plurals>
    <string name="template_description_duration">%1$s, about %2$d minutes</string>
    <string name="template_description">%1$s, %2$s</string>
    <string name="template_description_category">%1$s, %2$s, %3$s</string>

    <!-- ── Rest timer ─────────────────────────────────────────────────────────────── -->

    <string name="rest_timer_running">Rest</string>
    <string name="rest_timer_paused">Rest paused</string>
    <string name="rest_timer_finished">Rest complete</string>
    <string name="rest_timer_idle">No rest running</string>
    <string name="rest_timer_of_total">of %1$s</string>
    <string name="rest_timer_remaining">%1$s left</string>
    <string name="rest_timer_up_next">Next %1$s</string>
    <string name="rest_timer_shorter_label">−%1$ds</string>
    <string name="rest_timer_shorter">Shorten the rest by %1$d seconds</string>
    <string name="rest_timer_longer_label">+%1$ds</string>
    <string name="rest_timer_longer">Extend the rest by %1$d seconds</string>
    <string name="rest_timer_pause">Pause the rest</string>
    <string name="rest_timer_resume">Resume the rest</string>
    <string name="rest_timer_skip">Skip rest</string>
    <string name="rest_timer_next_set">Next set</string>

    <!-- ── Stats ──────────────────────────────────────────────────────────────────── -->

    <string name="stat_volume">Volume</string>
    <string name="stat_sets">Sets</string>
    <!-- Inside a chip, where it follows the figure in a phrase rather than heading it. -->
    <string name="stat_sets_short">sets</string>
    <string name="stat_sets_unit">total</string>
    <string name="stat_duration">Duration</string>
    <string name="stat_exercises">Exercises</string>
    <string name="stat_exercises_unit">done</string>
    <!-- The tile a session summary shows instead of the duration, which its own header
         already carries. -->
    <string name="stat_muscles">Muscles</string>
    <string name="stat_muscles_unit">worked</string>
    <!-- Announced as one phrase so TalkBack says "Volume, 4,820 kg" rather than reading a
         label and a number as two unrelated nodes. -->
    <string name="stat_description">%1$s, %2$s</string>

    <!-- Personal records. PrType's own names, as a lifter would say them. -->
    <string name="pr_badge">PR</string>
    <string name="pr_max_weight">Heaviest</string>
    <string name="pr_max_reps">Most reps</string>
    <string name="pr_max_volume">Most volume</string>
    <string name="pr_estimated_1rm">1RM</string>
    <string name="pr_max_distance">Furthest</string>
    <string name="pr_best_pace">Best pace</string>
    <string name="pr_description">Personal record: %1$s</string>
    <string name="pr_description_short">Personal record</string>
    <!-- A record's figure where the kind has no unit of its own to carry it. -->
    <plurals name="pr_value_reps">
        <item quantity="one">%1$d rep</item>
        <item quantity="other">%1$d reps</item>
    </plurals>
    <!-- Announced for a record shown as a bare figure: "Personal record, heaviest, 92 kg". -->
    <string name="pr_value_description">Personal record, %1$s, %2$s</string>

    <!-- ── Notes ─────────────────────────────────────────────────────────────────── -->

    <!-- The pencil's description, which says what pressing it does rather than what is under
         it — and that is not the same for a note that has not been written yet. The prompt
         shown in place of an absent note is the caller's, because it is the one part that
         differs between an exercise and a session. -->
    <string name="notes_add">Add a note</string>
    <string name="notes_edit">Edit the note</string>
    <string name="notes_save">Save</string>
    <string name="notes_cancel">Cancel</string>

    <!-- ── Search ─────────────────────────────────────────────────────────────────── -->

    <string name="search_placeholder">Search…</string>
    <string name="search_clear">Clear the search</string>

    <!-- ── Plates ─────────────────────────────────────────────────────────────────── -->

    <!-- The barbell diagram is announced as one sentence rather than as a dozen plates. -->
    <string name="plate_diagram_loaded">Barbell loaded with %1$s per side</string>
    <string name="plate_diagram_empty">Barbell with no plates on it</string>
    <!-- Quoted: Android trims unquoted whitespace, which runs the two plates together. -->
    <string name="plate_list_separator">", "</string>
    <!-- Spelled out rather than announced as "2 times 20 kg": the multiplication sign in the
         legend is a typographic convention, not something to read aloud. -->
    <plurals name="plate_count_description">
        <item quantity="one">%1$d plate of %2$s</item>
        <item quantity="other">%1$d plates of %2$s</item>
    </plurals>

    <string name="plate_legend_per_side">Per side</string>
    <!-- The count beside a legend row's weight. The description carries the words. -->
    <string name="plate_legend_count">× %1$d</string>

    <!-- ── Body diagram ───────────────────────────────────────────────────────────── -->

    <string name="body_view_front">Front</string>
    <string name="body_view_back">Back</string>
    <string name="body_muscles_worked">Muscles worked</string>
    <string name="body_diagram_none">Body diagram. No muscles highlighted.</string>
    <string name="body_diagram_primary">Body diagram. Worked directly: %1$s.</string>
    <string name="body_diagram_primary_and_secondary">Body diagram. Worked directly: %1$s. Also worked: %2$s.</string>
    <string name="body_diagram_secondary">Body diagram. Worked indirectly: %1$s.</string>
    <string name="body_muscle_separator">", "</string>

    <!-- ── Muscle contribution ────────────────────────────────────────────────────── -->

    <!-- A bar in the muscle breakdown, announced as one phrase: the muscle, the volume
         attributed to it, and which of the two tones the bar is drawn in. The bar's *length*
         is not spoken: it is relative to the hardest-worked muscle rather than a share of
         anything, and a percentage read aloud would claim a whole that does not exist. -->
    <string name="muscle_contribution_description_primary">%1$s, %2$s, worked directly</string>
    <string name="muscle_contribution_description_secondary">%1$s, %2$s, also worked</string>

    <!-- ── Sessions ──────────────────────────────────────────────────────────────── -->

    <!-- A session row's set count: "12 sets", in the mono line under the name. Abbreviated
         nowhere — "sets" is already the short word — but kept as a plural so a session with
         one set does not read "1 sets". -->
    <plurals name="session_set_count">
        <item quantity="one">%1$d set</item>
        <item quantity="other">%1$d sets</item>
    </plurals>
    <!-- The same count inside the row's spoken sentence, where "sets" needs no context. -->
    <plurals name="session_set_count_description">
        <item quantity="one">%1$d set</item>
        <item quantity="other">%1$d sets</item>
    </plurals>

    <!-- ── Training calendar ─────────────────────────────────────────────────────── -->

    <!-- One cell, announced as its date and what was done on it. The shade is not spoken:
         it is relative to the month rather than an absolute figure, so "heavy" read aloud
         would claim a comparison that does not survive turning the page. -->
    <plurals name="calendar_day_sessions">
        <item quantity="one">%1$s, %2$d session</item>
        <item quantity="other">%1$s, %2$d sessions</item>
    </plurals>
    <string name="calendar_day_rest">%1$s, rest day</string>
    <!-- What tapping a trained day does, as the click's own label. -->
    <string name="calendar_day_open">Show this day</string>

</resources>
