<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Declared here rather than in `:app` because this is the module that posts: `AndroidNotifier`
      is the only thing in the app that calls `NotificationManagerCompat.notify`, and a module
      that needs a permission to do its job should say so itself rather than depend on the
      composition root remembering on its behalf. The manifest merger carries it up into the APK.

      Requesting it is a separate matter and happens somewhere else entirely — the settings
      screen, at the moment the user turns their first notification on. A prompt with no context
      attached is the one most reliably denied, and a denial cannot be taken back.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      The exact alarm behind the background rest timer, in the two spellings the platform has
      had for it.

      `SCHEDULE_EXACT_ALARM` is granted at install below Android 13 and needs asking for above
      it, so it is capped at 32 and `USE_EXACT_ALARM` takes over from 33. That second permission
      is install-time and is reserved by Google Play for apps whose core function is an alarm
      clock, a calendar or a **timer**; a rest timer the user starts by hand, whose entire value
      is going off on the second, is squarely the third. The alternative — asking for
      `SCHEDULE_EXACT_ALARM` at runtime through a full-screen system settings page — is a
      prompt for a feature that has to work the first time somebody rests between two sets.

      `AndroidBackgroundRestTimer` checks `canScheduleExactAlarms()` regardless and falls back to
      an inexact wake-up, so a device or a policy that refuses leaves the alert late rather than
      absent.
    -->
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!--
      The reboot broadcast, for the alarms behind the workout reminder.

      `AlarmManager` keeps nothing across a restart, so without this a phone rebooted on Sunday
      night has no Monday reminder and says nothing about it — the setting is still on. The
      permission is install-time and covers only `BOOT_COMPLETED`; the app-update case
      (`MY_PACKAGE_REPLACED`) needs no permission and is handled by the same receiver.
    -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
      Health Connect's exercise sessions (#54), body weight and body fat (#350), each read and
      written.

      Declared here for the reason the notification permission above is: `HealthConnectAdapter`
      is the only class that uses them. None is granted at install. All six are asked for on the
      Health Connect settings screen, after a rationale, as one request — and the system dialog
      Health Connect shows for them only lists what is declared here, so these are also the
      ceiling on what the app can ever be granted.

      No READ_HEALTH_DATA_IN_BACKGROUND and no READ_HEALTH_DATA_HISTORY: an import is something the
      user starts, from a screen, and reaches back the thirty days Health Connect allows by default.
      The writes run in the background and need neither: background access is a rule about reads.
    -->
    <uses-permission android:name="android.permission.health.READ_EXERCISE" />
    <uses-permission android:name="android.permission.health.WRITE_EXERCISE" />
    <uses-permission android:name="android.permission.health.READ_WEIGHT" />
    <uses-permission android:name="android.permission.health.WRITE_WEIGHT" />
    <uses-permission android:name="android.permission.health.READ_BODY_FAT" />
    <uses-permission android:name="android.permission.health.WRITE_BODY_FAT" />

    <!--
      Package visibility for the Health Connect app, which is what provides it on Android 9 to 13.
      Without this, `getSdkStatus` cannot see that it is installed and answers "unavailable" on
      every phone where it is a separate app.
    -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <application>

        <!--
          The rest alarm going off, and "Skip rest" being pressed on the notification.

          `exported="false"`: both intents are explicit and come from this app's own pending
          intents, so nothing outside it has any business sending either. `directBootAware` is
          deliberately absent — a rest cannot be started before the device is unlocked, so there
          is none to announce in that window.
        -->
        <receiver
            android:name=".notification.RestTimerReceiver"
            android:exported="false" />

        <!--
          The idle-session alarm going off, and either of its buttons being pressed. Same
          reasoning as above: explicit intents from this app's own pending intents, so nothing
          outside it has any business sending one.
        -->
        <receiver
            android:name=".notification.IdleSessionReceiver"
            android:exported="false" />

        <!--
          A scheduled reminder falling due. `exported="false"` like the two above: the intent is
          explicit and comes from this app's own pending intent.
        -->
        <receiver
            android:name=".notification.ReminderReceiver"
            android:exported="false" />

        <!--
          The one receiver that is exported, because everything it listens for is a *system*
          broadcast and an un-exported receiver would never hear one.
          `android:exported="true"` is therefore required rather than incidental, and the
          receiver checks the action itself rather than trusting the filter — see BootReceiver.

          `MY_PACKAGE_REPLACED` sits in the same filter and is delivered only to this app. The
          two clock actions are there because an alarm holds an absolute instant while the
          schedule is a wall-clock time: a flight or a corrected clock leaves the seven standing
          alarms pointed at the wrong local time, and only a re-sync fixes it. Both are exempt
          from the background limits on implicit broadcasts, so a manifest receiver still hears
          them. The exact-alarm grant (Android 12 and 12L) is sent to this app alone, so it is
          heard too; it turns the reminders set while the permission was revoked exact again.

          Deliberately not `directBootAware`: the preferences the schedule is read from live in
          credential-encrypted storage, so there is nothing to read before the first unlock, and
          `BOOT_COMPLETED` already arrives after it.
        -->
        <receiver
            android:name=".notification.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
