<?xml version="1.0" encoding="utf-8"?>
<!--
  The only user-facing strings the data layer owns: the names Android shows for this app's
  notification channels, under Settings → Apps → Titan → Notifications.

  They live here rather than in `:core:ui` because the channels are registered here and
  nowhere else, and a name is what the user reads when deciding whether to silence a channel
  — so each description says what turning it off would cost, not what the channel is.
-->
<resources>

    <string name="notification_channel_reminders">Workout reminders</string>
    <string name="notification_channel_reminders_description">The nudge on the days you asked to train.</string>

    <string name="notification_channel_rest_timer">Rest timer</string>
    <string name="notification_channel_rest_timer_description">Says the rest is over when the screen is off. Turning this off means hearing nothing between sets.</string>

    <string name="notification_channel_session">Unfinished workouts</string>
    <string name="notification_channel_session_description">A silent reminder when a workout has been left open with nothing logged.</string>

    <string name="notification_channel_progression">Streaks and rewards</string>
    <string name="notification_channel_progression_description">New levels, completed quests and loot.</string>

    <!-- The rest countdown, as it reads from a lock screen. Two words and a number, because
         what it is for is a glance from across a bench: the countdown itself is drawn by the
         platform from the deadline, so none of this repeats it. -->
    <string name="rest_notification_resting">Resting</string>
    <string name="rest_notification_paused">Rest paused</string>
    <string name="rest_notification_over">Rest over</string>
    <!-- What the lifter goes back to: the exercise, and which set of it is next. -->
    <string name="rest_notification_next_up">%1$s · set %2$d</string>
    <!-- The same line for an exercise deleted from the library mid-session: the set number is
         still true, and the workout carries on. -->
    <string name="rest_notification_next_set">Set %1$d</string>
    <string name="rest_notification_skip">Skip rest</string>

    <!-- The nudge about a workout nobody is working out. Ambient rather than urgent: it goes
         out on a silent, low-importance channel, so the words carry all of it. The two buttons
         are the only two honest outcomes — come back to it, or close it out. -->
    <string name="idle_session_title">Workout still open</string>
    <string name="idle_session_body">%1$s · %2$s</string>
    <string name="idle_session_resume">Resume</string>
    <string name="idle_session_finish">Finish now</string>
    <string name="idle_session_discard">Discard</string>
    <!-- A session with nothing in it gets its own line rather than the plural's zero case.
         English has no `zero` plural category, so a count of none would come out of `other` as
         "0 sets logged", which reads as a fault where the sentence below reads as a state. -->
    <string name="idle_session_nothing_logged">Nothing logged yet</string>
    <plurals name="idle_session_sets">
        <item quantity="one">%1$d set logged, nothing since</item>
        <item quantity="other">%1$d sets logged, nothing since</item>
    </plurals>

    <!-- The scheduled reminder. Short, and it does not shout: the user asked for this at a
         time they chose, so it is a nudge rather than an alarm. The streak line is the one
         thing worth saying on top of the invitation, and it is only ever said while the
         streak is actually live. -->
    <string name="reminder_title">Time to train</string>
    <string name="reminder_body">Get it logged. It only counts if you write it down.</string>
    <plurals name="reminder_body_streak">
        <item quantity="one">%1$d day streak on the line. Keep it.</item>
        <item quantity="other">%1$d day streak on the line. Keep it.</item>
    </plurals>
    <string name="reminder_action_start">Start</string>

    <!-- The same reminder arriving while a workout is already open. Nobody needs telling to
         train when they are mid-session; what they may need is the way back into it. -->
    <string name="reminder_title_in_progress">Finish what you started</string>
    <string name="reminder_body_in_progress">Your workout is still open.</string>
    <string name="reminder_action_resume">Resume</string>

    <!-- What a finished workout earned, for a user who was not looking at the recap that
         would otherwise have celebrated it. Three headlines, because a session can save a
         streak, drop loot, or do both — and the two joined would be longer than a notification
         title gets to be before the platform truncates it. -->
    <string name="progression_notification_streak">Streak protection used</string>
    <string name="progression_notification_loot">New loot unlocked</string>
    <string name="progression_notification_both">Streak saved, and loot found</string>

    <!-- Both counts are plurals rather than a number pushed into a sentence: "1 protections
         left" is the failure that a concatenated count always eventually ships, and #41's
         languages have more categories than English does. -->
    <plurals name="progression_notification_streak_saved">
        <item quantity="one">Saved your %1$d-day streak.</item>
        <item quantity="other">Saved your %1$d-day streak.</item>
    </plurals>
    <plurals name="progression_notification_protections_left">
        <item quantity="one">%1$d protection left this month.</item>
        <item quantity="other">%1$d protections left this month.</item>
    </plurals>

    <!-- The rarity is spelled out rather than carried by the wireframe's glyph alone, which is
         decoration: a screen reader says nothing about it, and a colour is no use to somebody
         who cannot tell two of them apart. -->
    <string name="progression_notification_loot_found">You found a %1$s · %2$s.</string>
    <!-- Two sentences of one notification body, run together. A join rather than a space in
         Kotlin: the sentence order is the translator's to change, and so is what goes between
         them - some scripts do not separate sentences with a plain space. -->
    <string name="progression_notification_body_join">%1$s %2$s</string>

    <!--
      The collectible names and the rarity bands, a second copy of `:feature:progression`'s.

      No module can hold one copy. Android merges a library's resources into its *dependents*,
      and `:core:data` and a feature module are siblings that the architecture forbids from
      depending on each other — so the choice is two copies of fifteen short nouns, or a
      notification composed in the presentation layer where the app being dead means there is
      no presentation layer running. #41 has both sets to translate; a reword in one place
      leaves the other saying the old name. The ids they are keyed on are part of the storage
      contract and pinned by a test, so the mapping itself cannot drift.
    -->
    <string name="progression_collectible_chalk_block">Chalk block</string>
    <string name="progression_collectible_spare_collar">Spare collar</string>
    <string name="progression_collectible_worn_wristband">Worn wristband</string>
    <string name="progression_collectible_lifting_strap">Lifting strap</string>
    <string name="progression_collectible_steel_shaker">Steel shaker</string>
    <string name="progression_collectible_pet_egg">Pet egg</string>
    <string name="progression_collectible_golden_dumbbell">Golden dumbbell</string>
    <string name="progression_collectible_iron_crown">Iron crown</string>
    <!-- Deliberately not `:feature:progression`'s "Unknown find": that one is a list item and
         this one sits inside "You found a …", where a capitalised noun phrase reads as broken
         grammar. The two differing here is the sentence working, not the copies drifting. -->
    <string name="progression_collectible_unknown">new collectible</string>

    <string name="progression_rarity_common">Common</string>
    <string name="progression_rarity_uncommon">Uncommon</string>
    <string name="progression_rarity_rare">Rare</string>
    <string name="progression_rarity_epic">Epic</string>
    <string name="progression_rarity_legendary">Legendary</string>

    <!-- The default templates' names (#213), read once, when the database is created: each is
         an ordinary template from then on and the user renames it like any other, so a later
         change of language renames nothing. A name is a row title and the source of the
         initial drawn beside it, so it is short and leads with the word that tells it apart. -->
    <string name="default_template_push">Push</string>
    <string name="default_template_pull">Pull</string>
    <string name="default_template_legs">Legs</string>
    <string name="default_template_chest">Chest</string>
    <string name="default_template_back">Back</string>
    <string name="default_template_shoulders">Shoulders</string>
    <string name="default_template_arms">Arms</string>
    <string name="default_template_abs">Abs</string>
    <string name="default_template_upper_body">Upper body</string>
    <string name="default_template_lower_body">Lower body</string>
    <string name="default_template_full_body">Full body</string>
    <string name="default_template_glutes">Glutes</string>
    <string name="default_template_bodyweight">Bodyweight</string>
    <string name="default_template_hiit">HIIT</string>
    <string name="default_template_bike">Bike</string>
    <string name="default_template_row">Row</string>
    <string name="default_template_stretch">Stretch &amp; mobility</string>

</resources>
